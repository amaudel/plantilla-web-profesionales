---
import SEOMetadata from '../components/SEOMetadata.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import { config } from '../config';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  tags?: string[];
  canonical?: string;
}

const {
  title,
  description = 'Nixgo Digital diseña webs premium para profesionales y negocios de servicios.',
  image,
  type = 'website',
  publishedTime,
  tags,
  canonical,
} = Astro.props;

const gaTrackingId = import.meta.env.GOOGLE_ANALYTICS_ID || config.analytics.googleAnalyticsId;
const googleSiteVerification = import.meta.env.GOOGLE_SITE_VERIFICATION;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || '';
const defaultImage = `${siteUrl}/images/hero/optimized/nixgo-digital-experience-v2-1280.webp`;
const structuredImage = image
  ? image.startsWith('http') ? image : `${siteUrl}${image}`
  : defaultImage;
const canonicalUrl = canonical || `${siteUrl}${Astro.url.pathname}`;
const organizationStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: config.app.name,
  url: siteUrl,
  description,
};
const pageStructuredData = {
  '@context': 'https://schema.org',
  '@type': type === 'article' ? 'Article' : 'WebPage',
  headline: title,
  description,
  image: structuredImage,
  url: canonicalUrl,
  ...(publishedTime ? { datePublished: publishedTime } : {}),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon/favicon.svg" type="image/svg+xml">
    <link rel="alternate icon" href="/favicon/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png">
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png">
    <link rel="manifest" href="/favicon/site.webmanifest">
    <link
      rel="preload"
      as="image"
      href="/hero-scroll/nixgodigital/frame_001.webp"
      type="image/webp"
      fetchpriority="high"
    >
    <meta name="generator" content={Astro.generator} />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    <title>{title}</title>
    <SEOMetadata title={title} description={description} image={image} type={type} publishedTime={publishedTime} tags={tags} canonical={canonical} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationStructuredData)} />
    <script type="application/ld+json" set:html={JSON.stringify(pageStructuredData)} />
    <meta name="theme-color" content="#2563eb" />
    <style is:global>
      html { background: #030816; }
      body { @apply bg-white text-gray-900 dark:bg-gray-900 dark:text-white; }
    </style>
    <script>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          const storedTheme = localStorage.getItem('theme');
          if (storedTheme === 'light' || storedTheme === 'dark') return storedTheme;
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) return 'dark';
        return 'light';
      })();
      if (theme === 'dark') document.documentElement.classList.add('dark');
      window.localStorage.setItem('theme', theme);
      document.addEventListener('astro:after-swap', () => {
        if (localStorage.getItem('theme') === 'dark') document.documentElement.classList.add('dark');
      });
    </script>
  </head>
  <body>
    <slot />
    <FloatingWhatsApp />
    {gaTrackingId && (
      <script is:inline define:vars={{ gaTrackingId }}>
        window.addEventListener('load', function() {
          setTimeout(function() {
            const gtmScript = document.createElement('script');
            gtmScript.async = true;
            gtmScript.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaTrackingId;
            document.head.appendChild(gtmScript);
            gtmScript.onload = function() {
              window.dataLayer = window.dataLayer || [];
              window.gtag = function(){dataLayer.push(arguments);}
              window.gtag('js', new Date());
              window.gtag('config', gaTrackingId);
            };
          }, 1000);
        });
      </script>
    )}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      document.addEventListener('click', function (event) {
        const clickedElement = event.target instanceof Element ? event.target : null;
        const target = clickedElement ? clickedElement.closest('[data-track]') : null;
        const whatsappLink = clickedElement ? clickedElement.closest('a[href*="wa.me"], a[href*="whatsapp.com"]') : null;
        if (whatsappLink) {
          const eventData = {
            event: 'whatsapp_click',
            cta_name: whatsappLink.getAttribute('data-track') || 'whatsapp_link',
            page_path: window.location.pathname,
            link_url: whatsappLink.getAttribute('href'),
          };
          window.dataLayer.push(eventData);
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'whatsapp_click', {
              event_category: 'lead',
              event_label: eventData.cta_name,
              page_path: eventData.page_path,
              link_url: eventData.link_url,
            });
          }
        }
        if (!target) return;
        window.dataLayer.push({
          event: 'nixgo_cta_click',
          cta_name: target.getAttribute('data-track'),
          page_path: window.location.pathname,
        });
      });
    </script>
  </body>
</html>
