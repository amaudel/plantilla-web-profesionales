<form id="waitlist-form" class="space-y-4 max-w-md mx-auto bg-white dark:bg-gray-800 p-6 rounded-xl shadow">
  <input name="email" type="email" required placeholder="Correo electrónico" class="w-full px-3 py-2 rounded border border-gray-300 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-white" />
  <input name="interest" required placeholder="Qué tipo de web necesitas" class="w-full px-3 py-2 rounded border border-gray-300 dark:border-gray-700 bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-white" />
  <button type="submit" class="w-full py-2 rounded bg-gray-900 dark:bg-violet-600 text-white font-semibold hover:bg-indigo-600 dark:hover:bg-violet-500 transition">Quiero información</button>
  <div id="waitlist-status" class="text-center text-sm mt-2"></div>
</form>
<script type="module">
const form = document.getElementById('waitlist-form');
const status = document.getElementById('waitlist-status');
form.onsubmit = async (e) => {
  e.preventDefault();
  status.textContent = '';
  const data = Object.fromEntries(new FormData(form));
  const res = await fetch('/api/waitlist', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data)
  });
  const result = await res.json();
  if (result.success) {
    status.textContent = 'Solicitud recibida.';
    status.className = 'text-green-600 mt-2';
    form.reset();
  } else {
    status.textContent = result.error || 'No se pudo enviar la solicitud.';
    status.className = 'text-red-600 mt-2';
  }
};
</script>
