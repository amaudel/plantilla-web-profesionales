---
import { Icon } from 'astro-icon/components';

const packages = [
  {
    icon: 'tabler:message-2-check',
    name: 'Nixgo Chat Inicial',
    price: 'USD 249',
    monthly: 'USD 39/mes',
    ideal: 'Emprendedores y pequeños negocios',
    usage: '300 conversaciones incluidas',
    bestFor: 'FAQ, horarios y captura simple',
    payback: 'Se paga con 1 cliente pequeño adicional',
    note: 'Un chatbot sencillo y rápido de implementar para página web o Telegram, sin obligarte a configurar WhatsApp oficial desde el inicio.',
    features: [
      'Hasta 30 preguntas frecuentes',
      'Horarios, ubicación y servicios',
      'Captura de nombre, teléfono y necesidad',
      'Transferencia a una persona',
      'Panel básico y una actualización mensual',
      'Soporte por WhatsApp en horario laboral',
    ],
    cta: 'Cotizar Chat Inicial',
    href: 'https://wa.me/593984710898?text=Hola%2C%20quiero%20cotizar%20Nixgo%20Chat%20Inicial%20para%20mi%20negocio',
  },
  {
    icon: 'tabler:robot',
    name: 'Nixgo Chat Profesional',
    price: 'USD 499',
    monthly: 'USD 79/mes',
    ideal: 'Más elegido',
    usage: '1.000 conversaciones incluidas',
    bestFor: 'IA, citas y prospectos clasificados',
    payback: 'Pensado para recuperar la inversión con 1 venta media',
    note: 'El paquete principal para consultorios, abogados y empresas pequeñas que necesitan captar, clasificar y enviar prospectos al equipo comercial.',
    featured: true,
    features: [
      'IA entrenada con información del negocio',
      'Web más un canal de mensajería compatible',
      'Hasta 100 preguntas, servicios o documentos breves',
      'Captura, clasificación y solicitud de citas',
      'Panel de conversaciones y contactos',
      'Dos ajustes mensuales e informe básico',
    ],
    cta: 'Cotizar Chat Profesional',
    href: 'https://wa.me/593984710898?text=Hola%2C%20quiero%20cotizar%20Nixgo%20Chat%20Profesional%20para%20mi%20negocio',
  },
  {
    icon: 'tabler:automation',
    name: 'Nixgo Chat Empresa',
    price: 'Desde USD 899',
    monthly: 'Desde USD 149/mes',
    ideal: 'Empresas e integraciones',
    usage: '3.000 conversaciones incluidas',
    bestFor: 'Varios canales, áreas e integraciones',
    payback: 'Para operaciones donde cada lead tiene mayor valor',
    note: 'Para empresas con varios canales, sucursales, formularios conectados o una operación comercial que requiere seguimiento automático.',
    features: [
      'Hasta tres canales',
      'Base de conocimiento ampliada',
      'Servicios, áreas o sucursales diferenciadas',
      'Agenda o formulario conectado',
      'Panel con métricas y seguimiento automático',
      'Una integración estándar y optimización mensual',
    ],
    cta: 'Cotizar Chat Empresa',
    href: 'https://wa.me/593984710898?text=Hola%2C%20quiero%20cotizar%20Nixgo%20Chat%20Empresa%20para%20mi%20negocio',
  },
];

const comparisonRows = [
  ['Conversaciones incluidas', '300', '1.000', '3.000'],
  ['Canales', 'Web o Telegram', 'Web + canal compatible', 'Hasta 3 canales'],
  ['Base de conocimiento', '30 FAQs', '100 FAQs/documentos', 'Ampliada'],
  ['Ajustes mensuales', '1 ajuste', '2 ajustes', 'Optimización mensual'],
  ['Mejor para vender', 'Negocio local', 'Servicios profesionales', 'Equipos e integraciones'],
];
---

<section id="chatbots" class="relative overflow-hidden px-6 py-24 bg-[radial-gradient(circle_at_top_left,_rgba(59,130,246,0.08),_transparent_28%),linear-gradient(to_bottom,_#ffffff,_#eff6ff)] dark:bg-[radial-gradient(circle_at_top_left,_rgba(34,211,238,0.08),_transparent_28%),linear-gradient(to_bottom,_#0f172a,_#020617)]">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_82%_12%,rgba(34,211,238,0.08),transparent_24%)]" aria-hidden="true"></div>
  <div class="mx-auto max-w-7xl">
    <div data-reveal class="relative mb-12 grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-end">
      <div>
        <span class="inline-flex items-center rounded-full border border-blue-200/70 bg-white/80 px-4 py-1.5 text-sm font-semibold text-blue-700 backdrop-blur dark:border-cyan-400/20 dark:bg-slate-900/70 dark:text-cyan-300">
          Servicio de chatbots
        </span>
        <h2 class="mt-5 text-3xl font-bold tracking-tight text-gray-900 dark:text-white md:text-4xl">
          Chatbots que atienden y convierten prospectos
        </h2>
      </div>
      <div class="rounded-[28px] border border-blue-100 bg-white/82 p-5 shadow-[0_18px_45px_rgba(15,23,42,0.05)] backdrop-blur dark:border-cyan-400/15 dark:bg-slate-900/72">
        <p class="text-lg leading-relaxed text-gray-700 dark:text-gray-300">
          Implementamos asistentes para web, Telegram o canales compatibles que explican tus servicios, filtran interesados y dejan la conversación lista para cerrar con una persona.
        </p>
        <div class="mt-4 grid gap-3 text-sm sm:grid-cols-3">
          <div class="rounded-2xl bg-blue-50 px-4 py-3 text-blue-800 dark:bg-cyan-300/10 dark:text-cyan-100">
            <strong class="block text-gray-950 dark:text-white">24/7</strong>
            Atiende fuera de horario
          </div>
          <div class="rounded-2xl bg-blue-50 px-4 py-3 text-blue-800 dark:bg-cyan-300/10 dark:text-cyan-100">
            <strong class="block text-gray-950 dark:text-white">Lead listo</strong>
            Nombre, teléfono y necesidad
          </div>
          <div class="rounded-2xl bg-blue-50 px-4 py-3 text-blue-800 dark:bg-cyan-300/10 dark:text-cyan-100">
            <strong class="block text-gray-950 dark:text-white">ROI simple</strong>
            Una venta puede cubrir el bot
          </div>
        </div>
      </div>
    </div>

    <div data-reveal class="relative mb-8 grid gap-4 rounded-[28px] border border-blue-100 bg-white/80 p-4 shadow-[0_18px_45px_rgba(15,23,42,0.05)] dark:border-cyan-400/15 dark:bg-slate-900/70 md:grid-cols-3">
      <div class="rounded-2xl bg-slate-950 px-5 py-4 text-white dark:bg-white dark:text-slate-950">
        <div class="text-xs font-semibold uppercase tracking-[0.16em] text-cyan-200 dark:text-blue-700">Oferta de lanzamiento</div>
        <div class="mt-1 text-2xl font-bold">30% menos</div>
        <p class="mt-1 text-sm text-slate-300 dark:text-slate-600">En implementación para los primeros 5 clientes.</p>
      </div>
      <div class="rounded-2xl border border-slate-200/80 bg-slate-50 px-5 py-4 dark:border-slate-800 dark:bg-slate-950/60">
        <div class="text-xs font-semibold uppercase tracking-[0.16em] text-blue-600 dark:text-cyan-300">Plan recomendado</div>
        <div class="mt-1 text-2xl font-bold text-gray-900 dark:text-white">Profesional</div>
        <p class="mt-1 text-sm text-gray-600 dark:text-gray-300">Mejor balance entre IA, citas, leads y mensualidad.</p>
      </div>
      <div class="rounded-2xl border border-slate-200/80 bg-slate-50 px-5 py-4 dark:border-slate-800 dark:bg-slate-950/60">
        <div class="text-xs font-semibold uppercase tracking-[0.16em] text-blue-600 dark:text-cyan-300">Forma de pago</div>
        <div class="mt-1 text-2xl font-bold text-gray-900 dark:text-white">50/50</div>
        <p class="mt-1 text-sm text-gray-600 dark:text-gray-300">50% al iniciar y 50% al publicar el bot.</p>
      </div>
    </div>

    <div class="relative grid grid-cols-1 gap-6 lg:grid-cols-3 lg:items-stretch">
      {packages.map((item, index) => (
        <div data-reveal data-reveal-delay={String(Math.min(index * 0.06, 0.18))} class:list={[
          "group relative flex h-full flex-col rounded-[30px] border p-7 shadow-[0_18px_45px_rgba(15,23,42,0.06)] transition-all duration-300 hover:-translate-y-1",
          item.featured
            ? "border-cyan-300/20 bg-[linear-gradient(160deg,rgba(37,99,235,0.96),rgba(8,47,73,0.95))] text-white shadow-[0_28px_70px_rgba(37,99,235,0.28)] scale-[1.01]"
            : "border-slate-200/80 bg-white/78 text-slate-950 backdrop-blur-xl dark:border-slate-800 dark:bg-slate-900/72 dark:text-white"
        ]}>
          <div class="mb-6 flex items-center justify-between gap-4">
            <div class:list={["flex h-12 w-12 items-center justify-center rounded-2xl border", item.featured ? "border-white/15 bg-white/10 text-white" : "border-blue-100 bg-blue-50 text-blue-700 dark:border-cyan-400/20 dark:bg-cyan-300/10 dark:text-cyan-300"]}>
              <Icon name={item.icon} class="h-6 w-6" aria-hidden="true" />
            </div>
            <span class:list={["rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em]", item.featured ? "bg-cyan-300/15 text-cyan-50" : "bg-blue-50 text-blue-700 dark:bg-cyan-300/10 dark:text-cyan-200"]}>
              {item.ideal}
            </span>
          </div>

          <h3 class:list={["text-2xl font-bold tracking-tight", item.featured ? "text-white" : "text-gray-900 dark:text-white"]}>{item.name}</h3>
          <p class:list={["mt-2 text-sm font-semibold", item.featured ? "text-cyan-100" : "text-blue-700 dark:text-cyan-200"]}>{item.bestFor}</p>
          <div class="mt-5 grid gap-3">
            <div>
              <div class:list={["text-xs font-semibold uppercase tracking-[0.16em]", item.featured ? "text-cyan-100" : "text-blue-600 dark:text-cyan-300"]}>Implementación</div>
              <div class:list={["mt-1 text-4xl font-bold", item.featured ? "text-white" : "text-gray-900 dark:text-white"]}>{item.price}</div>
            </div>
            <div class:list={["rounded-2xl border px-4 py-3", item.featured ? "border-white/12 bg-white/8" : "border-slate-200/70 bg-slate-50/90 dark:border-slate-800 dark:bg-slate-950/60"]}>
              <div class:list={["text-xs font-semibold uppercase tracking-[0.16em]", item.featured ? "text-cyan-100" : "text-blue-600 dark:text-cyan-300"]}>Mensualidad</div>
              <div class:list={["mt-1 text-lg font-bold", item.featured ? "text-cyan-50" : "text-blue-700 dark:text-cyan-200"]}>{item.monthly}</div>
            </div>
          </div>
          <div class:list={["mt-4 inline-flex w-fit rounded-full px-3 py-1 text-xs font-semibold", item.featured ? "bg-white/10 text-cyan-50" : "bg-blue-50 text-blue-700 dark:bg-cyan-300/10 dark:text-cyan-200"]}>{item.usage}</div>
          <div class:list={["mt-3 rounded-2xl border px-4 py-3 text-sm font-semibold", item.featured ? "border-white/12 bg-white/8 text-cyan-50" : "border-emerald-100 bg-emerald-50 text-emerald-800 dark:border-emerald-400/15 dark:bg-emerald-400/10 dark:text-emerald-100"]}>
            {item.payback}
          </div>
          <p class:list={["mt-5 leading-relaxed", item.featured ? "text-sky-100" : "text-gray-600 dark:text-gray-300"]}>{item.note}</p>

          <div class="mt-8 flex-1 space-y-3">
            {item.features.map((feature) => (
              <div class:list={["flex items-start gap-3 rounded-2xl border px-4 py-3 text-sm leading-relaxed", item.featured ? "border-white/12 bg-white/8 text-white backdrop-blur-sm" : "border-slate-200/70 bg-slate-50/90 text-gray-700 dark:border-slate-800 dark:bg-slate-950/60 dark:text-gray-300"]}>
                <Icon name="tabler:circle-check" class:list={["mt-0.5 h-4 w-4 shrink-0", item.featured ? "text-cyan-100" : "text-blue-600 dark:text-cyan-300"]} aria-hidden="true" />
                <span>{feature}</span>
              </div>
            ))}
          </div>

          <a href={item.href} class:list={["mt-8 inline-flex w-full justify-center rounded-2xl px-6 py-3.5 font-semibold transition", item.featured ? "bg-white text-blue-700 hover:bg-blue-50" : "bg-blue-600 text-white shadow-lg shadow-blue-500/20 hover:bg-blue-700"]}>
            {item.cta}
          </a>
        </div>
      ))}
    </div>

    <div data-reveal class="relative mt-10 grid gap-4 rounded-[28px] border border-blue-100 bg-white/80 p-6 shadow-[0_18px_45px_rgba(15,23,42,0.05)] dark:border-cyan-400/15 dark:bg-slate-900/70 md:grid-cols-[1fr_auto] md:items-center">
      <div>
        <p class="text-base font-semibold text-gray-900 dark:text-white">
          Precios con uso razonable incluido. WhatsApp Business, proveedores externos, IA, campañas masivas e integraciones especiales se cotizan por separado.
        </p>
        <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-300">
          Primeros cinco clientes: 30% de descuento en implementación, mensualidad sin descuento y permanencia mínima sugerida de tres meses.
        </p>
      </div>
      <div class="rounded-2xl bg-blue-600 px-4 py-3 text-sm font-semibold text-white dark:bg-cyan-300 dark:text-slate-950">
        50% al iniciar / 50% al publicar
      </div>
    </div>

    <div data-reveal class="relative mt-8 overflow-hidden rounded-[28px] border border-blue-100 bg-white/82 shadow-[0_18px_45px_rgba(15,23,42,0.05)] dark:border-cyan-400/15 dark:bg-slate-900/72">
      <div class="grid gap-4 border-b border-slate-200/70 p-6 dark:border-slate-800 md:grid-cols-[0.85fr_1.15fr] md:items-end">
        <div>
          <div class="text-sm font-semibold uppercase tracking-[0.16em] text-blue-600 dark:text-cyan-300">Comparación rápida</div>
          <h3 class="mt-2 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">Elige por etapa, no solo por precio</h3>
        </div>
        <p class="text-sm leading-relaxed text-gray-600 dark:text-gray-300">
          Esta vista ayuda a que el cliente entienda rápido qué recibe, qué límite tiene y cuándo conviene subir de plan.
        </p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[760px] text-left text-sm">
          <thead class="bg-blue-50/80 text-xs uppercase tracking-[0.14em] text-blue-700 dark:bg-slate-950/60 dark:text-cyan-200">
            <tr>
              <th class="px-5 py-4 font-semibold">Criterio</th>
              <th class="px-5 py-4 font-semibold">Inicial</th>
              <th class="px-5 py-4 font-semibold">Profesional</th>
              <th class="px-5 py-4 font-semibold">Empresa</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200/70 dark:divide-slate-800">
            {comparisonRows.map((row) => (
              <tr class="text-gray-700 dark:text-gray-300">
                {row.map((cell, cellIndex) => (
                  <td class:list={["px-5 py-4", cellIndex === 0 ? "font-semibold text-gray-950 dark:text-white" : "", cellIndex === 2 ? "bg-blue-50/55 font-semibold text-blue-800 dark:bg-cyan-300/10 dark:text-cyan-100" : ""]}>
                    {cell}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
