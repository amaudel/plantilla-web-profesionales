---
const testimonials = [
  {
    quote: 'Una demo por nicho acorta mucho la conversación comercial porque el cliente ya se imagina su web funcionando.',
    name: 'Médicos',
    role: 'Nicho donde la confianza visual pesa mucho',
    initials: 'ME',
  },
  {
    quote: 'Cuando la estructura transmite criterio y orden, vender servicios profesionales se vuelve bastante más fácil.',
    name: 'Abogados',
    role: 'Nicho donde importa seriedad y respaldo',
    initials: 'AB',
  },
  {
    quote: 'En wellness y servicios premium, el look correcto sí cambia la percepción de valor y la intención de contacto.',
    name: 'Wellness',
    role: 'Nicho donde estética y cercanía convierten',
    initials: 'WE',
  },
];

const badges = ['Demos por nicho', 'Percepción premium', 'Copy comercial', 'CTA directos'];
---

<section id="testimonios" class="py-24 px-6 bg-gradient-to-b from-blue-50 to-white dark:from-gray-900 dark:to-gray-950 transition-colors duration-300">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 text-sm font-medium mb-4">Valor comercial</span>
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">Los nichos correctos entienden rápido el valor cuando la demo está bien aterrizada</h2>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
        Esta sección funciona como prueba estratégica: muestra qué tipo de percepción y argumento comercial se puede construir por segmento.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
      {testimonials.map((item) => (
        <div class="relative p-7 rounded-3xl bg-white/95 dark:bg-gray-800/95 backdrop-blur shadow-xl border border-blue-100 dark:border-blue-900/30">
          <div class="absolute top-0 right-0 w-24 h-24 bg-blue-100/60 dark:bg-blue-900/20 blur-2xl rounded-full"></div>
          <div class="relative">
            <div class="text-4xl text-blue-200 dark:text-blue-800 mb-3">“</div>
            <p class="text-gray-600 dark:text-gray-300 mb-6 leading-relaxed">{item.quote}”</p>
            <div class="flex items-center">
              <div class="w-11 h-11 rounded-2xl bg-blue-100 dark:bg-blue-900/50 flex items-center justify-center mr-3 shadow-sm">
                <span class="text-blue-600 dark:text-blue-400 font-medium">{item.initials}</span>
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 dark:text-white">{item.name}</h4>
                <p class="text-sm text-gray-600 dark:text-gray-400">{item.role}</p>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="flex flex-wrap gap-4 justify-center">
      {badges.map((badge) => (
        <div class="px-5 py-3 rounded-full bg-white/90 dark:bg-gray-800/90 border border-blue-100 dark:border-blue-900/30 text-gray-700 dark:text-gray-300 shadow-sm">
          {badge}
        </div>
      ))}
    </div>
  </div>
</section>
