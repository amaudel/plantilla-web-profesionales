---
const proofPoints = [
  {
    quote: 'Cuando la web explica el servicio con orden, el cliente llega con menos dudas y más intención.',
    name: 'Servicios médicos',
    role: 'Autoridad, explicación y contacto rápido',
    initials: 'SM',
  },
  {
    quote: 'Una presentación sobria ayuda a que el visitante perciba criterio antes de pedir una consulta.',
    name: 'Servicios legales',
    role: 'Seriedad, especialidad y confianza',
    initials: 'SL',
  },
  {
    quote: 'En servicios de alto valor, el diseño y el tono influyen en cuánto valor percibe el cliente.',
    name: 'Bienestar y servicios premium',
    role: 'Cercanía, estética y diferenciación',
    initials: 'WP',
  },
];

const badges = ['Mejor percepción', 'Oferta más clara', 'Menos dudas', 'Más intención'];
---

<section id="testimonios" class="py-24 px-6 bg-gradient-to-b from-blue-50 to-white dark:from-gray-900 dark:to-gray-950 transition-colors duration-300">
  <div class="max-w-7xl mx-auto">
    <div data-reveal class="text-center mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 text-sm font-medium mb-4">Lo que debe demostrar tu web</span>
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">Antes de vender, tu web tiene que hacer que confiar sea fácil</h2>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
        Estas son las señales que trabajamos para que el visitante no solo mire, sino que avance hacia una consulta.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
      {proofPoints.map((item, index) => (
        <div data-reveal data-reveal-delay={String(Math.min(index * 0.06, 0.18))} class="relative p-7 rounded-3xl bg-white/95 dark:bg-gray-800/95 backdrop-blur shadow-xl border border-blue-100 dark:border-blue-900/30">
          <div class="absolute top-0 right-0 w-24 h-24 bg-blue-100/60 dark:bg-blue-900/20 blur-2xl rounded-full"></div>
          <div class="relative">
            <div class="text-4xl text-blue-200 dark:text-blue-800 mb-3">“</div>
            <p class="text-gray-600 dark:text-gray-300 mb-6 leading-relaxed">{item.quote}”</p>
            <div class="flex items-center">
              <div class="w-11 h-11 rounded-2xl bg-blue-100 dark:bg-blue-900/50 flex items-center justify-center mr-3 shadow-sm">
                <span class="text-blue-600 dark:text-blue-400 font-medium">{item.initials}</span>
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 dark:text-white">{item.name}</h4>
                <p class="text-sm text-gray-600 dark:text-gray-400">{item.role}</p>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="flex flex-wrap gap-4 justify-center">
      {badges.map((badge) => (
        <div class="px-5 py-3 rounded-full bg-white/90 dark:bg-gray-800/90 border border-blue-100 dark:border-blue-900/30 text-gray-700 dark:text-gray-300 shadow-sm">
          {badge}
        </div>
      ))}
    </div>
  </div>
</section>
