---
import { Icon } from 'astro-icon/components';

const packages = [
  {
    icon: 'tabler:rocket',
    name: 'Landing Profesional',
    price: 'Desde USD 199',
    ideal: 'Para empezar rápido',
    note: 'Para presentar una oferta puntual, campaña o servicio con una página clara y lista para WhatsApp.',
    features: [
      '1 página enfocada en una oferta',
      'CTA directo a WhatsApp',
      'Mensaje claro para explicar tu servicio',
      'Diseño adaptado a tu sector',
    ],
    cta: 'Quiero mi landing',
    href: 'https://wa.me/593984710898?text=Hola%2C%20quiero%20una%20Landing%20Profesional',
  },
  {
    icon: 'tabler:briefcase-2',
    name: 'Web Profesional',
    price: 'Desde USD 399',
    ideal: 'Mejor opción inicial',
    note: 'Para negocios que quieren presentar varios servicios, generar confianza y recibir consultas mejor preparadas.',
    featured: true,
    features: [
      'Sitio completo tipo landing extendida',
      'Estructura clara para presentar tus servicios',
      'Bloques de confianza, proceso y prueba',
      'Lista para compartir en redes o campañas',
    ],
    cta: 'Quiero una web profesional',
    href: 'https://wa.me/593984710898?text=Hola%2C%20quiero%20una%20Web%20Profesional',
  },
  {
    icon: 'tabler:diamond',
    name: 'Web Premium',
    price: 'Desde USD 599',
    ideal: 'Para servicios de alto valor',
    note: 'Para marcas y profesionales que necesitan una presencia más completa, diferencial y premium.',
    features: [
      'Mayor personalización visual',
      'Assets y secciones más cuidadas',
      'Más señales de autoridad',
      'Experiencia pensada para tickets altos',
    ],
    cta: 'Quiero una web premium',
    href: 'https://wa.me/593984710898?text=Hola%2C%20quiero%20una%20Web%20Premium',
  },
];
---

<section id="paquetes" class="py-24 px-6 bg-[radial-gradient(circle_at_top_right,_rgba(59,130,246,0.08),_transparent_26%),linear-gradient(to_bottom,_#eff6ff,_#ffffff)] dark:bg-[radial-gradient(circle_at_top_right,_rgba(34,211,238,0.08),_transparent_26%),linear-gradient(to_bottom,_#020617,_#0f172a)]">
  <div class="max-w-7xl mx-auto">
    <div data-reveal class="text-center mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full border border-blue-200/70 dark:border-cyan-400/20 bg-white/80 dark:bg-slate-900/70 text-blue-700 dark:text-cyan-300 text-sm font-semibold mb-4 backdrop-blur">
        Paquetes base
      </span>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 dark:text-white mb-4">
        Elige la web según la etapa de tu negocio
      </h2>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
        Paquetes claros para lanzar tu presencia online, presentar tus servicios y convertir visitas en mensajes por WhatsApp.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
      {packages.map((item, index) => (
        <div data-reveal data-reveal-delay={String(Math.min(index * 0.06, 0.18))} class:list={[
          "relative rounded-[30px] border p-8 backdrop-blur-xl shadow-[0_18px_45px_rgba(15,23,42,0.06)] transition-all duration-300 hover:-translate-y-1 flex flex-col",
          item.featured
            ? "bg-[linear-gradient(160deg,rgba(37,99,235,0.96),rgba(8,47,73,0.95))] text-white border-cyan-300/20 shadow-[0_28px_70px_rgba(37,99,235,0.28)] scale-[1.01]"
            : "bg-white/78 dark:bg-slate-900/72 border-slate-200/80 dark:border-slate-800"
        ]}>
          <div class="mb-6">
            <div class="mb-5 flex items-center justify-between gap-4">
              <div class:list={["flex h-12 w-12 items-center justify-center rounded-2xl border", item.featured ? "border-white/15 bg-white/10 text-white" : "border-blue-100 bg-blue-50 text-blue-700 dark:border-cyan-400/20 dark:bg-cyan-300/10 dark:text-cyan-300"]}>
                <Icon name={item.icon} class="h-6 w-6" aria-hidden="true" />
              </div>
              <div class:list={["text-right text-sm uppercase tracking-[0.18em] font-semibold", item.featured ? "text-cyan-100" : "text-blue-600 dark:text-cyan-300"]}>
                {item.featured ? 'Más recomendado' : 'Paquete'}
              </div>
            </div>
            <h3 class:list={["text-2xl font-bold tracking-tight mb-2", item.featured ? "text-white" : "text-gray-900 dark:text-white"]}>{item.name}</h3>
            <div class:list={["mb-3 inline-flex rounded-full px-3 py-1 text-xs font-semibold", item.featured ? "bg-cyan-300/15 text-cyan-50" : "bg-blue-50 text-blue-700 dark:bg-cyan-300/10 dark:text-cyan-200"]}>
              {item.ideal}
            </div>
            <div class:list={["text-4xl font-bold mb-3", item.featured ? "text-white" : "text-gray-900 dark:text-white"]}>{item.price}</div>
            <p class:list={["leading-relaxed", item.featured ? "text-sky-100" : "text-gray-600 dark:text-gray-300"]}>{item.note}</p>
          </div>

          <div class="space-y-3 mb-8 flex-1">
            {item.features.map((feature) => (
              <div class:list={["flex items-start gap-3 rounded-2xl px-4 py-3 text-sm leading-relaxed border", item.featured ? "bg-white/8 text-white border-white/12 backdrop-blur-sm" : "bg-slate-50/90 dark:bg-slate-950/60 text-gray-700 dark:text-gray-300 border-slate-200/70 dark:border-slate-800"]}>
                <Icon name="tabler:circle-check" class:list={["mt-0.5 h-4 w-4 shrink-0", item.featured ? "text-cyan-100" : "text-blue-600 dark:text-cyan-300"]} aria-hidden="true" />
                <span>{feature}</span>
              </div>
            ))}
          </div>

          <a href={item.href} class:list={["inline-flex w-full justify-center rounded-2xl px-6 py-3.5 font-semibold transition", item.featured ? "bg-white text-blue-700 hover:bg-blue-50" : "bg-blue-600 text-white hover:bg-blue-700 shadow-lg shadow-blue-500/20"]}>
            {item.cta}
          </a>
        </div>
      ))}
    </div>

    <div data-reveal class="mt-10 rounded-[28px] border border-blue-100 bg-white/80 p-6 text-center shadow-[0_18px_45px_rgba(15,23,42,0.05)] dark:border-cyan-400/15 dark:bg-slate-900/70">
      <p class="text-base font-semibold text-gray-900 dark:text-white">
        ¿No sabes cuál elegir? Escríbenos por WhatsApp y revisamos qué opción encaja mejor con tu negocio, presupuesto y urgencia.
      </p>
    </div>
  </div>
</section>
