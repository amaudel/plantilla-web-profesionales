---
const packages = [
  {
    name: 'Landing Nicho',
    price: 'USD 199',
    note: 'Para validar oferta y empezar a captar contactos.',
    features: [
      '1 página enfocada en una oferta',
      'CTA directo a WhatsApp o formulario',
      'Copy comercial base',
      'Look profesional adaptado al nicho',
    ],
    cta: 'Quiero una landing',
    href: 'https://wa.me/593984710898?text=Hola%2C%20quiero%20una%20Landing%20Nicho',
  },
  {
    name: 'Web Profesional',
    price: 'USD 399',
    note: 'La mejor opción para vender servicios con más claridad y respaldo.',
    featured: true,
    features: [
      'Sitio completo de varias secciones',
      'Estructura comercial por nicho',
      'Servicios, proceso, prueba y CTA',
      'Base premium lista para mostrar o vender',
    ],
    cta: 'Quiero una web profesional',
    href: 'https://wa.me/593984710898?text=Hola%2C%20quiero%20una%20Web%20Profesional',
  },
  {
    name: 'Web Premium',
    price: 'USD 599+',
    note: 'Para negocios que necesitan una presentación más fuerte y más personalización.',
    features: [
      'Mayor personalización visual',
      'Assets, bloques y narrativa más premium',
      'Mejor percepción de autoridad',
      'Base pensada para vender mejor y escalar',
    ],
    cta: 'Quiero una web premium',
    href: 'https://wa.me/593984710898?text=Hola%2C%20quiero%20una%20Web%20Premium',
  },
];
---

<section id="paquetes" class="py-24 px-6 bg-gray-50 dark:bg-gray-900">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 text-sm font-medium mb-4">
        Paquetes base
      </span>
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
        Precios claros para arrancar más rápido la conversación comercial
      </h2>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
        No todo cliente necesita lo mismo. Estos paquetes te ayudan a filtrar, ordenar expectativas y vender con más estructura.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      {packages.map((item) => (
        <div class:list={["rounded-3xl border p-8 shadow-sm", item.featured ? "bg-blue-600 text-white border-blue-500 scale-[1.01]" : "bg-white dark:bg-gray-800 border-blue-100 dark:border-blue-900/30"]}>
          <div class="mb-6">
            <div class:list={["text-sm uppercase tracking-[0.18em] mb-3", item.featured ? "text-blue-100" : "text-blue-600 dark:text-blue-400"]}>
              {item.featured ? 'Más recomendado' : 'Paquete'}
            </div>
            <h3 class:list={["text-2xl font-bold mb-2", item.featured ? "text-white" : "text-gray-900 dark:text-white"]}>{item.name}</h3>
            <div class:list={["text-4xl font-bold mb-3", item.featured ? "text-white" : "text-gray-900 dark:text-white"]}>{item.price}</div>
            <p class:list={["leading-relaxed", item.featured ? "text-blue-100" : "text-gray-600 dark:text-gray-300"]}>{item.note}</p>
          </div>

          <div class="space-y-3 mb-8">
            {item.features.map((feature) => (
              <div class:list={["rounded-2xl px-4 py-3 text-sm", item.featured ? "bg-white/10 text-white border border-white/10" : "bg-gray-50 dark:bg-gray-900 text-gray-700 dark:text-gray-300"]}>
                {feature}
              </div>
            ))}
          </div>

          <a href={item.href} class:list={["inline-flex w-full justify-center rounded-xl px-6 py-3 font-semibold transition", item.featured ? "bg-white text-blue-700 hover:bg-blue-50" : "bg-blue-600 text-white hover:bg-blue-700"]}>
            {item.cta}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
