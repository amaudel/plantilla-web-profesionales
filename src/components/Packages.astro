---
const packages = [
  {
    name: 'Landing Profesional',
    price: 'USD 199',
    note: 'Ideal para profesionales que necesitan presencia clara y una salida rápida para empezar a captar contactos.',
    features: [
      '1 página enfocada en una oferta',
      'CTA directo a WhatsApp o formulario',
      'Copy comercial base',
      'Look profesional adaptado al nicho',
    ],
    cta: 'Quiero mi landing',
    href: 'https://wa.me/593984710898?text=Hola%2C%20quiero%20una%20Landing%20Profesional',
  },
  {
    name: 'Web Profesional',
    price: 'USD 399',
    note: 'La mejor opción para vender servicios con más claridad, respaldo y velocidad comercial.',
    featured: true,
    features: [
      'Sitio completo de varias secciones',
      'Estructura clara para presentar tus servicios',
      'Servicios, proceso, credibilidad y CTA',
      'Base premium lista para mostrar y captar contactos',
    ],
    cta: 'Quiero una web profesional',
    href: 'https://wa.me/593984710898?text=Hola%2C%20quiero%20una%20Web%20Profesional',
  },
  {
    name: 'Web Premium',
    price: 'USD 599+',
    note: 'Para negocios que necesitan una presentación más fuerte, más personalización y una percepción premium desde el primer contacto.',
    features: [
      'Mayor personalización visual',
      'Assets, bloques y narrativa más premium',
      'Mejor percepción de autoridad',
      'Experiencia más fuerte para negocios que venden valor alto',
    ],
    cta: 'Quiero una web premium',
    href: 'https://wa.me/593984710898?text=Hola%2C%20quiero%20una%20Web%20Premium',
  },
];
---

<section id="paquetes" class="py-24 px-6 bg-[radial-gradient(circle_at_top_right,_rgba(59,130,246,0.08),_transparent_26%),linear-gradient(to_bottom,_#eff6ff,_#ffffff)] dark:bg-[radial-gradient(circle_at_top_right,_rgba(34,211,238,0.08),_transparent_26%),linear-gradient(to_bottom,_#020617,_#0f172a)]">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full border border-blue-200/70 dark:border-cyan-400/20 bg-white/80 dark:bg-slate-900/70 text-blue-700 dark:text-cyan-300 text-sm font-semibold mb-4 backdrop-blur">
        Paquetes base
      </span>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 dark:text-white mb-4">
        Paquetes claros para elegir la web que mejor se ajusta a tu negocio
      </h2>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
        No todos los negocios necesitan lo mismo. Estos paquetes te ayudan a comprar una solución más clara y más rápida de implementar según tu etapa.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
      {packages.map((item) => (
        <div class:list={[
          "relative rounded-[30px] border p-8 backdrop-blur-xl shadow-[0_18px_45px_rgba(15,23,42,0.06)] transition-all duration-300 hover:-translate-y-1 flex flex-col",
          item.featured
            ? "bg-[linear-gradient(160deg,rgba(37,99,235,0.96),rgba(8,47,73,0.95))] text-white border-cyan-300/20 shadow-[0_28px_70px_rgba(37,99,235,0.28)] scale-[1.01]"
            : "bg-white/78 dark:bg-slate-900/72 border-slate-200/80 dark:border-slate-800"
        ]}>
          <div class="mb-6">
            <div class:list={["text-sm uppercase tracking-[0.18em] mb-3 font-semibold", item.featured ? "text-cyan-100" : "text-blue-600 dark:text-cyan-300"]}>
              {item.featured ? 'Más recomendado' : 'Paquete'}
            </div>
            <h3 class:list={["text-2xl font-bold tracking-tight mb-2", item.featured ? "text-white" : "text-gray-900 dark:text-white"]}>{item.name}</h3>
            <div class:list={["text-4xl font-bold mb-3", item.featured ? "text-white" : "text-gray-900 dark:text-white"]}>{item.price}</div>
            <p class:list={["leading-relaxed", item.featured ? "text-sky-100" : "text-gray-600 dark:text-gray-300"]}>{item.note}</p>
          </div>

          <div class="space-y-3 mb-8 flex-1">
            {item.features.map((feature) => (
              <div class:list={["rounded-2xl px-4 py-3 text-sm leading-relaxed border", item.featured ? "bg-white/8 text-white border-white/12 backdrop-blur-sm" : "bg-slate-50/90 dark:bg-slate-950/60 text-gray-700 dark:text-gray-300 border-slate-200/70 dark:border-slate-800"]}>
                {feature}
              </div>
            ))}
          </div>

          <a href={item.href} class:list={["inline-flex w-full justify-center rounded-2xl px-6 py-3.5 font-semibold transition", item.featured ? "bg-white text-blue-700 hover:bg-blue-50" : "bg-blue-600 text-white hover:bg-blue-700 shadow-lg shadow-blue-500/20"]}>
            {item.cta}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
