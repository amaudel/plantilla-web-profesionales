---
const niches = [
  {
    name: 'Médicos y especialistas',
    angle: 'Una presencia seria para explicar servicios, trayectoria y próximos pasos sin saturar al paciente.',
    bullets: ['Autoridad visible', 'Servicios entendibles', 'Contacto directo'],
    cta: 'Ver demo médica',
    href: '/medicos-cuenca',
  },
  {
    name: 'Abogados y firmas legales',
    angle: 'Una web sobria para ordenar áreas de práctica, mostrar criterio y facilitar consultas mejor perfiladas.',
    bullets: ['Imagen seria', 'Áreas claras', 'Consultas calificadas'],
    cta: 'Consultar enfoque legal',
    href: '#contacto',
  },
  {
    name: 'Psicología y bienestar',
    angle: 'Un tono humano y cuidado para que el visitante entienda si eres la opción correcta para su situación.',
    bullets: ['Tono cercano', 'Oferta guiada', 'Menos fricción'],
    cta: 'Consultar enfoque bienestar',
    href: '#contacto',
  },
  {
    name: 'Consultores y servicios premium',
    angle: 'Una estructura comercial para vender experiencia, método y resultado sin depender solo de una llamada.',
    bullets: ['Posicionamiento', 'Método claro', 'CTA a reunión'],
    cta: 'Consultar enfoque consultoría',
    href: '#contacto',
  },
];
---

<section id="nichos" class="py-24 px-6 bg-white dark:bg-gray-950">
  <div class="max-w-7xl mx-auto">
    <div data-reveal class="text-center mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full border border-blue-200/70 dark:border-cyan-400/20 bg-white/80 dark:bg-slate-900/70 text-blue-700 dark:text-cyan-300 text-sm font-semibold mb-4 backdrop-blur">
        Copy y diseño por nicho
      </span>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 dark:text-white mb-4">
        La misma plantilla no vende igual para todos los servicios
      </h2>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
        Adaptamos el mensaje, la jerarquía y las pruebas de confianza según cómo decide tu cliente: urgencia, autoridad, cercanía o valor percibido.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {niches.map((niche, index) => (
        <div data-reveal data-reveal-delay={String(Math.min(index * 0.06, 0.18))} class="group relative isolate overflow-hidden rounded-[30px] border border-slate-200/80 bg-white/84 p-8 shadow-[0_18px_45px_rgba(15,23,42,0.06)] backdrop-blur-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_24px_60px_rgba(37,99,235,0.10)] dark:border-slate-800 dark:bg-slate-900/72">
          <div class="pointer-events-none absolute -bottom-6 -right-2 z-0 select-none bg-gradient-to-br from-blue-600/10 via-cyan-400/12 to-slate-950/5 bg-clip-text text-[8.5rem] font-black leading-none tracking-tight text-transparent transition-opacity duration-300 group-hover:opacity-90 dark:from-cyan-200/10 dark:via-blue-400/12 dark:to-white/5 md:text-[11rem]">
            {String(index + 1).padStart(2, '0')}
          </div>
          <div class="pointer-events-none absolute bottom-0 right-0 z-0 h-40 w-40 rounded-full bg-cyan-300/8 blur-3xl dark:bg-cyan-300/10"></div>

          <div class="relative z-10 mb-5">
            <div>
              <div class="text-sm uppercase tracking-[0.18em] text-blue-600 dark:text-cyan-300 mb-2 font-semibold">Sector {String(index + 1).padStart(2, '0')}</div>
              <h3 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white">{niche.name}</h3>
            </div>
          </div>

          <p class="relative z-10 text-gray-600 dark:text-gray-300 mb-6 leading-relaxed">{niche.angle}</p>

          <div class="relative z-10 flex flex-wrap gap-3 mb-8">
            {niche.bullets.map((bullet) => (
              <span class="px-4 py-2 rounded-full bg-slate-50 dark:bg-slate-950/70 border border-slate-200/70 dark:border-slate-800 text-sm text-gray-700 dark:text-gray-300">
                {bullet}
              </span>
            ))}
          </div>

          <a href={niche.href} data-track={`sector_${index + 1}`} class="relative z-10 inline-flex items-center rounded-2xl bg-blue-600 px-5 py-3 text-white font-semibold hover:bg-blue-700 transition shadow-lg shadow-blue-500/20">
            {niche.cta}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
