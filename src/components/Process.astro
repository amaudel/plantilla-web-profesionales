---
const steps = [
  {
    number: '01',
    title: 'Entiendo tu oferta',
    description: 'Aterrizamos qué vendes, a quién quieres atraer y qué dudas necesita resolver tu web antes del primer mensaje.',
  },
  {
    number: '02',
    title: 'Construyo el argumento',
    description: 'Ordeno el mensaje para que el visitante entienda tu valor, vea señales de confianza y sepa qué hacer después.',
  },
  {
    number: '03',
    title: 'Diseño la experiencia',
    description: 'Trabajo el look, la jerarquía y los CTA para que todo se sienta serio, claro y alineado con tu nicho.',
  },
  {
    number: '04',
    title: 'Publicamos y ajustamos',
    description: 'Dejo la web lista para compartir, revisar con clientes reales y mejorarla con lo que el mercado responda.',
  },
];
---

<section id="proceso" class="py-24 bg-white dark:bg-gray-950">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 text-sm font-medium mb-4">Proceso</span>
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
        Un proceso simple para pasar de idea a web vendible
      </h2>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
        La web se construye alrededor de tu oferta, no alrededor de bloques bonitos sin estrategia.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {steps.map((step) => (
        <div class="rounded-2xl border border-blue-100 dark:border-blue-900/40 bg-gray-50 dark:bg-gray-900 p-8">
          <div class="text-blue-600 dark:text-blue-400 font-bold text-sm mb-4">{step.number}</div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">{step.title}</h3>
          <p class="text-gray-600 dark:text-gray-300 leading-relaxed">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
