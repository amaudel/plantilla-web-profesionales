---
const steps = [
  {
    number: '01',
    title: 'Defino el nicho y la oferta',
    description: 'Primero aclaro qué se vende, a quién y con qué ángulo para que la web no salga genérica.',
  },
  {
    number: '02',
    title: 'Armo estructura y mensaje',
    description: 'Organizo hero, objeciones, servicios, prueba y CTA según cómo decide ese tipo de cliente.',
  },
  {
    number: '03',
    title: 'Pulimos look y assets',
    description: 'Se ajusta la presentación visual para subir percepción de valor y coherencia con el nicho.',
  },
  {
    number: '04',
    title: 'Publico y dejo lista para vender',
    description: 'La web queda preparada para mostrar, enviar por WhatsApp, usar como demo o captar clientes reales.',
  },
];
---

<section id="proceso" class="py-24 bg-white dark:bg-gray-950">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 text-sm font-medium mb-4">Proceso</span>
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
        Cómo trabajo contigo
      </h2>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
        Este es el proceso para convertir una idea o servicio en una web clara, profesional y lista para captar contactos.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {steps.map((step) => (
        <div class="rounded-2xl border border-blue-100 dark:border-blue-900/40 bg-gray-50 dark:bg-gray-900 p-8">
          <div class="text-blue-600 dark:text-blue-400 font-bold text-sm mb-4">{step.number}</div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">{step.title}</h3>
          <p class="text-gray-600 dark:text-gray-300 leading-relaxed">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
