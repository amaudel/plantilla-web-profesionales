---
const steps = [
  {
    number: '01',
    title: 'Entiendo tu oferta',
    description: 'Aterrizamos qué vendes, a quién quieres atraer y qué dudas necesita resolver tu web antes del primer mensaje.',
  },
  {
    number: '02',
    title: 'Construyo el argumento',
    description: 'Ordeno el mensaje para que el visitante entienda tu valor, vea señales de confianza y sepa qué hacer después.',
  },
  {
    number: '03',
    title: 'Diseño la experiencia',
    description: 'Trabajo el look, la jerarquía y los CTA para que todo se sienta serio, claro y alineado con tu nicho.',
  },
  {
    number: '04',
    title: 'Publicamos y ajustamos',
    description: 'Dejo la web lista para compartir, revisar con clientes reales y mejorarla con lo que el mercado responda.',
  },
];
---

<section id="proceso" class="py-24 bg-white dark:bg-gray-950">
  <div class="max-w-7xl mx-auto px-6">
    <div data-reveal class="text-center mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 text-sm font-medium mb-4">Proceso</span>
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-gray-900 dark:text-white mb-4">
        Un proceso simple para pasar de idea a web vendible
      </h2>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
        La web se construye alrededor de tu oferta, no alrededor de bloques bonitos sin estrategia.
      </p>
    </div>

    <div class="relative">
      <div class="absolute left-6 top-6 hidden h-px w-[calc(100%-3rem)] bg-gradient-to-r from-blue-200 via-cyan-200 to-transparent dark:from-cyan-400/30 dark:via-blue-400/20 lg:block"></div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
        {steps.map((step, index) => (
          <div data-reveal data-reveal-delay={String(Math.min(index * 0.05, 0.18))} class="relative rounded-[28px] border border-slate-200/80 bg-slate-50 p-6 shadow-[0_18px_45px_rgba(15,23,42,0.05)] dark:border-slate-800 dark:bg-slate-900/70">
            <div class="mb-8 flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-600 text-sm font-bold text-white shadow-lg shadow-blue-500/20 dark:bg-cyan-300 dark:text-slate-950">
              {step.number}
            </div>
            <h3 class="text-xl font-semibold tracking-tight text-gray-900 dark:text-white mb-3">{step.title}</h3>
            <p class="text-gray-600 dark:text-gray-300 leading-relaxed">{step.description}</p>
          </div>
        ))}
      </div>
    </div>

    <div data-reveal class="mt-10 rounded-[28px] border border-blue-100 bg-blue-50/80 p-6 text-center dark:border-cyan-400/20 dark:bg-slate-900/80 md:p-8">
      <div class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-700 dark:text-cyan-300">Resultado</div>
      <p class="mx-auto mt-3 max-w-3xl text-lg text-gray-700 dark:text-gray-300">
        Una web que se puede enviar por WhatsApp, poner en redes o usar en campañas sin tener que explicar todo desde cero.
      </p>
    </div>
  </div>
</section>
