---
const steps = [
  {
    number: '01',
    title: 'Definimos tu servicio principal',
    description: 'Primero aclaro qué ofreces, a quién te diriges y qué necesitas comunicar para que la web tenga sentido.',
  },
  {
    number: '02',
    title: 'Organizo la estructura y el mensaje',
    description: 'Ordeno la página para que tu cliente entienda rápido quién eres, qué haces y cómo puede contactarte.',
  },
  {
    number: '03',
    title: 'Pulimos diseño y presentación',
    description: 'Ajusto la parte visual para que tu negocio se vea más profesional, más claro y más confiable.',
  },
  {
    number: '04',
    title: 'Publico y dejo todo listo',
    description: 'La web queda preparada para compartirla, recibir contactos y empezar a usarla de verdad.',
  },
];
---

<section id="proceso" class="py-24 bg-white dark:bg-gray-950">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 text-sm font-medium mb-4">Proceso</span>
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
        Cómo se construye tu web
      </h2>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
        Este es el proceso para convertir tu servicio en una web clara, profesional y lista para generar confianza y contactos.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {steps.map((step) => (
        <div class="rounded-2xl border border-blue-100 dark:border-blue-900/40 bg-gray-50 dark:bg-gray-900 p-8">
          <div class="text-blue-600 dark:text-blue-400 font-bold text-sm mb-4">{step.number}</div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">{step.title}</h3>
          <p class="text-gray-600 dark:text-gray-300 leading-relaxed">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
