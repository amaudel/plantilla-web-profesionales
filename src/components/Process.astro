---
const steps = [
  {
    number: '01',
    title: 'Contacto inicial',
    description: 'El visitante escribe, llama o envía su consulta para explicar brevemente su necesidad.',
  },
  {
    number: '02',
    title: 'Valoración y orientación',
    description: 'Se revisa el caso, se aclaran dudas y se define la mejor forma de avanzar según la situación.',
  },
  {
    number: '03',
    title: 'Atención del servicio',
    description: 'Se realiza la atención principal con un enfoque claro, profesional y orientado al resultado.',
  },
  {
    number: '04',
    title: 'Seguimiento',
    description: 'Cuando aplica, se da continuidad para asegurar claridad, confianza y próximos pasos definidos.',
  },
];
---

<section id="proceso" class="py-24 bg-white dark:bg-gray-950">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 text-sm font-medium mb-4">Proceso</span>
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
        Un proceso claro para facilitar la atención
      </h2>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
        Este bloque reduce fricción porque explica de forma simple cómo funciona el servicio.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {steps.map((step) => (
        <div class="rounded-2xl border border-blue-100 dark:border-blue-900/40 bg-gray-50 dark:bg-gray-900 p-8">
          <div class="text-blue-600 dark:text-blue-400 font-bold text-sm mb-4">{step.number}</div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">{step.title}</h3>
          <p class="text-gray-600 dark:text-gray-300 leading-relaxed">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
