---
const steps = [
  {
    number: '01',
    title: 'Agendamiento de cita',
    description: 'El paciente se contacta por WhatsApp o llamada para coordinar la consulta inicial.',
  },
  {
    number: '02',
    title: 'Valoración médica',
    description: 'Se revisan síntomas, antecedentes y exámenes disponibles para entender con claridad el caso.',
  },
  {
    number: '03',
    title: 'Diagnóstico y plan',
    description: 'Se explica la recomendación, el tratamiento posible o los pasos necesarios según la condición del paciente.',
  },
  {
    number: '04',
    title: 'Seguimiento',
    description: 'Si aplica, se acompaña la evolución del paciente y se resuelven dudas antes o después del procedimiento.',
  },
];
---

<section id="proceso" class="py-24 bg-white dark:bg-gray-950">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 text-sm font-medium mb-4">Proceso</span>
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
        Un proceso claro para que el paciente sepa qué esperar
      </h2>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
        Explicar el paso a paso reduce ansiedad, transmite orden y facilita la toma de decisión.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {steps.map((step) => (
        <div class="rounded-2xl border border-blue-100 dark:border-blue-900/40 bg-gray-50 dark:bg-gray-900 p-8">
          <div class="text-blue-600 dark:text-blue-400 font-bold text-sm mb-4">{step.number}</div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">{step.title}</h3>
          <p class="text-gray-600 dark:text-gray-300 leading-relaxed">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
