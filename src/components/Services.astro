---
const services = [
  {
    title: 'Landing page profesional',
    description: 'Una página para vender una oferta concreta: qué haces, por qué confiar y cómo contactarte sin rodeos.',
  },
  {
    title: 'Web comercial completa',
    description: 'Un sitio para presentar servicios, proceso, sectores, casos y rutas claras hacia WhatsApp o consulta.',
  },
  {
    title: 'Webs adaptadas a tu sector',
    description: 'Copy y estructura ajustados a médicos, abogados, bienestar, consultores y otros servicios de alto criterio.',
  },
  {
    title: 'Copy orientado a conversión',
    description: 'Textos que reducen dudas, ordenan tu propuesta y preparan al visitante para escribir con más intención.',
  },
  {
    title: 'Diseño con look premium',
    description: 'Una estética cuidada para elevar percepción de valor y evitar que tu web parezca otra plantilla más.',
  },
  {
    title: 'Estructura clara para vender',
    description: 'Secciones pensadas para guiar la decisión: problema, solución, prueba, oferta, proceso y acción.',
  },
];
---

<section id="servicios" class="py-24 bg-[radial-gradient(circle_at_top_left,_rgba(59,130,246,0.08),_transparent_28%),linear-gradient(to_bottom,_#f8fafc,_#ffffff)] dark:bg-[radial-gradient(circle_at_top_left,_rgba(34,211,238,0.08),_transparent_28%),linear-gradient(to_bottom,_#020617,_#0f172a)]">
  <div class="max-w-7xl mx-auto px-6">
    <div data-reveal class="text-center mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full border border-blue-200/70 dark:border-cyan-400/20 bg-white/80 dark:bg-slate-900/70 text-blue-700 dark:text-cyan-300 text-sm font-semibold mb-4 backdrop-blur">Qué entrego</span>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 dark:text-white mb-4">
        Qué incluye una web pensada para vender servicios
      </h2>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
        No es solo diseño. Es estrategia de presentación, copy, estructura comercial y una experiencia clara para convertir visitantes en conversaciones.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {services.map((service, index) => (
        <div data-reveal data-reveal-delay={String(Math.min(index * 0.04, 0.16))} class="group h-full rounded-[28px] border border-slate-200/80 dark:border-slate-800 bg-white/75 dark:bg-slate-900/70 backdrop-blur-xl p-8 shadow-[0_18px_45px_rgba(15,23,42,0.06)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_24px_60px_rgba(37,99,235,0.12)]">
          <div class="mb-6 flex items-center justify-between">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-blue-600 to-cyan-400 flex items-center justify-center text-white font-bold text-sm shadow-lg shadow-blue-500/20">0{index + 1}</div>
            <div class="h-px flex-1 ml-4 bg-gradient-to-r from-blue-200/70 to-transparent dark:from-cyan-400/30"></div>
          </div>
          <h3 class="text-xl font-semibold tracking-tight text-gray-900 dark:text-white mb-4">{service.title}</h3>
          <p class="text-gray-600 dark:text-gray-300 leading-relaxed">{service.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
