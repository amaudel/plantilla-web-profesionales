---
const services = [
  {
    title: 'Landing por nicho',
    description: 'Una página enfocada en una oferta concreta, con mensaje claro, autoridad visual y CTA directo a WhatsApp o formulario.',
  },
  {
    title: 'Web comercial completa',
    description: 'Sitio más robusto para negocios que necesitan presentar servicios, proceso, pruebas y varias rutas de conversión.',
  },
  {
    title: 'Demos para cerrar ventas',
    description: 'Ejemplos por sector para que el cliente vea rápido cómo se podría ver su negocio y entienda mejor tu propuesta.',
  },
  {
    title: 'Copy orientado a conversión',
    description: 'Textos claros para explicar lo que haces, generar confianza y facilitar que te escriban.',
  },
  {
    title: 'Assets y look premium',
    description: 'Selección o creación de recursos visuales que eleven percepción profesional y eviten el look genérico de plantilla.',
  },
  {
    title: 'Base escalable por nichos',
    description: 'Una base que se puede adaptar a médicos, abogados, wellness, consultoría y otros servicios sin empezar de cero.',
  },
];
---

<section id="servicios" class="py-24 bg-gray-50 dark:bg-gray-900">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 text-sm font-medium mb-4">Qué entrego</span>
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
        Qué ofrezco exactamente
      </h2>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
        Ofrezco landing pages, webs comerciales y demos por sector para que tu negocio se vea mejor, explique mejor su valor y consiga más contactos.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {services.map((service) => (
        <div class="relative group">
          <div class="absolute inset-0.5 bg-gradient-to-r from-blue-100 to-blue-50 dark:from-blue-900/30 dark:to-blue-800/20 rounded-2xl"></div>
          <div class="relative h-full bg-white dark:bg-gray-800 p-8 rounded-2xl border border-blue-100 dark:border-blue-800/40">
            <div class="w-12 h-12 rounded-xl bg-blue-100 dark:bg-blue-900/40 flex items-center justify-center mb-6 text-blue-600 dark:text-blue-400 font-bold text-lg group-hover:scale-110 transition-transform duration-300">+</div>
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">{service.title}</h3>
            <p class="text-gray-600 dark:text-gray-300 leading-relaxed">{service.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
