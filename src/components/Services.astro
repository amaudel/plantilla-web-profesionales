---
const services = [
  {
    title: 'Consulta de valoración quirúrgica',
    description: 'Revisión clínica inicial para entender el caso, evaluar síntomas y orientar el tratamiento o estudio más conveniente.',
  },
  {
    title: 'Cirugía laparoscópica',
    description: 'Abordaje mínimamente invasivo para procedimientos seleccionados, con enfoque en seguridad y recuperación organizada.',
  },
  {
    title: 'Tratamiento de hernias',
    description: 'Valoración y manejo quirúrgico de hernias abdominales e inguinales según el caso y la condición del paciente.',
  },
  {
    title: 'Cirugía de vesícula y apéndice',
    description: 'Atención y resolución de cuadros frecuentes que requieren criterio quirúrgico claro y seguimiento responsable.',
  },
  {
    title: 'Segunda opinión médica',
    description: 'Espacio para revisar diagnósticos o recomendaciones previas antes de tomar una decisión importante.',
  },
  {
    title: 'Seguimiento postoperatorio',
    description: 'Acompañamiento posterior al procedimiento para controlar evolución, recuperación y dudas del paciente.',
  },
];
---

<section id="servicios" class="py-24 bg-gray-50 dark:bg-gray-900">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 text-sm font-medium mb-4">Servicios</span>
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
        Atención quirúrgica y valoración médica enfocadas en claridad, seguridad y seguimiento
      </h2>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
        Esta demo muestra cómo puede presentarse una oferta médica de forma profesional, clara y fácil de entender.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {services.map((service) => (
        <div class="relative group">
          <div class="absolute inset-0.5 bg-gradient-to-r from-blue-100 to-blue-50 dark:from-blue-900/30 dark:to-blue-800/20 rounded-2xl"></div>
          <div class="relative h-full bg-white dark:bg-gray-800 p-8 rounded-2xl border border-blue-100 dark:border-blue-800/40">
            <div class="w-12 h-12 rounded-xl bg-blue-100 dark:bg-blue-900/40 flex items-center justify-center mb-6 text-blue-600 dark:text-blue-400 font-bold text-lg group-hover:scale-110 transition-transform duration-300">+</div>
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">{service.title}</h3>
            <p class="text-gray-600 dark:text-gray-300 leading-relaxed">{service.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
