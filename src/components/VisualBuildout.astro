---
import { Icon } from 'astro-icon/components';

const buildItems = [
  {
    label: 'Estructura',
    icon: 'tabler:layout-dashboard',
    title: 'Estructura estratégica',
    text: 'Diseñamos cada sección con un objetivo claro: convertir visitantes en clientes.',
    image: 'medical-website-mockup',
    alt: 'Mockup de una landing profesional con estructura clara de servicios',
  },
  {
    label: 'Contacto',
    icon: 'tabler:message-circle',
    title: 'Contacto directo',
    text: 'Botones de WhatsApp, formularios inteligentes y contacto fácil desde cualquier dispositivo.',
    image: 'google-business-profile',
    alt: 'Mockup visual de contacto y presencia digital conectada a WhatsApp',
  },
  {
    label: 'Confianza',
    icon: 'tabler:shield-check',
    title: 'Confianza y credibilidad',
    text: 'Diseño que transmite profesionalismo y genera confianza desde el primer segundo.',
    image: 'before-after-medical-presence',
    alt: 'Comparación visual entre presencia digital básica y presencia profesional',
  },
  {
    label: 'SEO',
    icon: 'tabler:search',
    title: 'Posicionamiento SEO',
    text: 'Tu sitio optimizado para que te encuentren en Google y conquistes tu nicho.',
    image: 'google-business-profile',
    alt: 'Mockup visual de posicionamiento digital y búsqueda profesional',
  },
];

const picture = (image: string) => ({
  avif: `/images/medical-offer/optimized/${image}-512.avif 512w, /images/medical-offer/optimized/${image}-1024.avif 1024w`,
  webp: `/images/medical-offer/optimized/${image}-512.webp 512w, /images/medical-offer/optimized/${image}-1024.webp 1024w`,
  png: `/images/medical-offer/optimized/${image}-1024.png`,
});
---

<section id="entregables" class="relative overflow-hidden bg-[#020612] px-5 pb-24 pt-28 text-white sm:px-6 lg:pt-32">
  <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,rgba(8,18,40,0)_0%,rgba(8,18,40,0.52)_52%,rgba(2,6,18,0)_100%)]"></div>
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-cyan-300/24 to-transparent"></div>

  <div class="relative mx-auto max-w-7xl">
    <div data-reveal class="mx-auto mb-12 max-w-3xl text-center lg:mb-14">
      <div class="text-xs font-bold uppercase tracking-[0.26em] text-cyan-300 sm:text-sm">Qué construimos</div>
      <h2 class="mt-4 text-3xl font-bold leading-tight tracking-tight md:text-5xl">
        Sitios web que trabajan por tu negocio
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-slate-300 md:text-lg">
        Creamos experiencias digitales estratégicas que convierten visitantes en clientes y fortalecen tu presencia online.
      </p>
    </div>

    <div class="grid gap-5 lg:grid-cols-2">
      {buildItems.map((item, index) => {
        const sources = picture(item.image);
        return (
          <article data-reveal data-reveal-delay={String(Math.min(index * 0.05, 0.15))} class="group relative overflow-hidden rounded-[22px] border border-cyan-300/14 bg-[linear-gradient(145deg,rgba(8,19,42,0.94),rgba(2,6,18,0.98))] p-5 shadow-[0_20px_55px_rgba(0,0,0,0.28)] transition duration-300 hover:border-cyan-300/28 md:min-h-[292px] md:p-6">
            <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(115deg,rgba(34,211,238,0.11),transparent_34%,rgba(37,99,235,0.10)_100%)] opacity-70 transition duration-300 group-hover:opacity-100"></div>
            <div class="pointer-events-none absolute inset-x-6 top-0 h-px bg-gradient-to-r from-transparent via-cyan-200/34 to-transparent"></div>

            <div class="relative grid h-full gap-6 md:grid-cols-[0.78fr_1.22fr] md:items-center">
              <div>
                <div class="mb-7 flex h-14 w-14 items-center justify-center rounded-[16px] border border-cyan-200/16 bg-cyan-300/12 text-cyan-200 shadow-[0_0_32px_rgba(34,211,238,0.18)]">
                  <Icon name={item.icon} class="h-7 w-7" aria-hidden="true" />
                </div>
                <div class="mb-3 text-xs font-bold uppercase tracking-[0.22em] text-cyan-300">{item.label}</div>
                <h3 class="text-2xl font-bold tracking-tight text-white md:text-[1.65rem]">{item.title}</h3>
                <p class="mt-4 max-w-[18rem] text-[0.95rem] leading-relaxed text-slate-300">{item.text}</p>
              </div>

              <div class="relative overflow-hidden rounded-[18px] border border-white/10 bg-slate-950/82 shadow-[inset_0_1px_0_rgba(255,255,255,0.08),0_18px_46px_rgba(0,0,0,0.25)]">
                <div class="pointer-events-none absolute inset-0 z-10 bg-[linear-gradient(180deg,rgba(255,255,255,0.04),transparent_38%),linear-gradient(90deg,rgba(34,211,238,0.10),transparent_32%)]"></div>
                <picture>
                  <source type="image/avif" srcset={sources.avif} />
                  <source type="image/webp" srcset={sources.webp} />
                  <img src={sources.png} alt={item.alt} width="1024" height="576" sizes="(min-width: 1280px) 390px, (min-width: 1024px) 31vw, 100vw" class="aspect-[16/10] w-full object-cover object-center opacity-95 transition duration-300 group-hover:scale-[1.015] group-hover:opacity-100 md:aspect-[16/9]" loading="lazy" decoding="async" />
                </picture>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<section id="antes-despues" class="bg-[linear-gradient(to_bottom,_#ffffff,_#f8fafc)] px-6 py-24 dark:bg-[linear-gradient(to_bottom,_#0f172a,_#020617)]">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
      <div data-reveal>
        <span class="inline-block rounded-full border border-blue-200/70 bg-white/80 px-4 py-1.5 text-sm font-semibold text-blue-700 backdrop-blur dark:border-cyan-400/20 dark:bg-slate-900/70 dark:text-cyan-300">
          Antes / después
        </span>
        <h2 class="mt-5 text-3xl font-bold leading-tight tracking-tight text-slate-950 md:text-4xl dark:text-white">
          La diferencia no es decorar: es ordenar la decisión
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-600 dark:text-slate-300">
          Una web genérica obliga al cliente a interpretar. Una web bien diseñada le muestra rápido si confía, si entiende la oferta y si quiere escribir.
        </p>

        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          <div class="rounded-[24px] border border-slate-200 bg-white p-5 shadow-[0_16px_45px_rgba(15,23,42,0.06)] dark:border-slate-800 dark:bg-slate-900">
            <div class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Antes</div>
            <ul class="mt-4 space-y-3 text-slate-600 dark:text-slate-300">
              <li>Mensaje disperso</li>
              <li>Poca prueba visual</li>
              <li>CTA difícil de encontrar</li>
            </ul>
          </div>
          <div class="rounded-[24px] border border-blue-200 bg-blue-600 p-5 text-white shadow-[0_18px_50px_rgba(37,99,235,0.22)]">
            <div class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-100">Después</div>
            <ul class="mt-4 space-y-3 text-blue-50">
              <li>Oferta clara</li>
              <li>Visuales que respaldan</li>
              <li>WhatsApp como acción obvia</li>
            </ul>
          </div>
        </div>
      </div>

      <div data-reveal data-reveal-delay="0.1" class="overflow-hidden rounded-[34px] border border-slate-200 bg-slate-950 p-3 shadow-[0_28px_80px_rgba(15,23,42,0.2)] dark:border-slate-800">
        <div class="mb-3 hidden items-center gap-2 px-2 sm:flex">
          <span class="h-3 w-3 rounded-full bg-red-400"></span>
          <span class="h-3 w-3 rounded-full bg-amber-400"></span>
          <span class="h-3 w-3 rounded-full bg-emerald-400"></span>
          <span class="ml-3 text-xs text-slate-400">presencia profesional</span>
        </div>
        <picture>
          <source type="image/avif" srcset="/images/medical-offer/optimized/before-after-medical-presence-512.avif 512w, /images/medical-offer/optimized/before-after-medical-presence-1024.avif 1024w" sizes="(min-width: 1024px) 52vw, 100vw" />
          <source type="image/webp" srcset="/images/medical-offer/optimized/before-after-medical-presence-512.webp 512w, /images/medical-offer/optimized/before-after-medical-presence-1024.webp 1024w" sizes="(min-width: 1024px) 52vw, 100vw" />
          <img src="/images/medical-offer/optimized/before-after-medical-presence-1024.png" alt="Antes y después de una presencia digital profesional" width="1024" height="1024" class="max-h-[540px] w-full rounded-[24px] object-cover object-center" loading="lazy" decoding="async" />
        </picture>
      </div>
    </div>
  </div>
</section>
