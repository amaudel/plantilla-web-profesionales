---
import { BriefcaseBusiness, MessageCircle, Phone } from 'lucide-astro';
---

<section id="inicio" class="hero-section relative min-h-[90vh] md:min-h-screen overflow-hidden bg-[#071126] text-white">
  <div class="hero-bg absolute inset-0" aria-hidden="true"></div>
  <div class="hero-overlay absolute inset-0" aria-hidden="true"></div>
  <div class="hero-glow absolute inset-0" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto flex min-h-[90vh] md:min-h-screen max-w-7xl items-center px-6 pt-28 pb-16 md:pt-32 md:pb-20">
    <div class="w-full flex justify-end">
      <div class="max-w-2xl text-left md:text-left">
        <span class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/8 px-4 py-1.5 text-sm font-medium text-blue-100 backdrop-blur-md">
          <BriefcaseBusiness class="h-4 w-4" />
          Nicho Digital · webs premium para profesionales y negocios de servicios
        </span>

        <h1 class="mb-6 text-4xl font-bold leading-tight text-white md:text-6xl">
          Haz que tu negocio se vea
          <span class="text-cyan-300"> más profesional y te ayude a vender con más velocidad</span>
        </h1>

        <p class="mb-8 max-w-xl text-lg leading-relaxed text-slate-200 md:text-xl">
          Creamos webs para médicos, abogados, psicólogos y negocios de servicios que necesitan transmitir más confianza, explicar mejor sus servicios y convertir visitas en contactos reales sin perder tiempo en explicaciones repetidas.
        </p>

        <div class="mb-10 flex flex-col gap-4 sm:flex-row">
          <a href="#contacto" class="inline-flex items-center justify-center gap-2 rounded-xl bg-cyan-400 px-6 py-3 font-semibold text-slate-950 transition hover:bg-cyan-300">
            <MessageCircle class="h-5 w-5" />
            Cotizar por WhatsApp
          </a>
          <a href="#nichos" class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/15 bg-white/6 px-6 py-3 font-medium text-white backdrop-blur-sm transition hover:bg-white/12">
            <Phone class="h-5 w-5" />
            Ver sectores
          </a>
        </div>

        <div class="grid gap-4 sm:grid-cols-3">
          <div class="rounded-2xl border border-white/10 bg-white/7 p-4 backdrop-blur-md shadow-[0_20px_60px_rgba(2,6,23,0.24)]">
            <div class="text-2xl font-bold text-white">Sectores</div>
            <div class="text-sm text-slate-300">médicos, legales, bienestar y más</div>
          </div>
          <div class="rounded-2xl border border-white/10 bg-white/7 p-4 backdrop-blur-md shadow-[0_20px_60px_rgba(2,6,23,0.24)]">
            <div class="text-2xl font-bold text-white">Claridad</div>
            <div class="text-sm text-slate-300">mensajes directos para generar confianza</div>
          </div>
          <div class="rounded-2xl border border-white/10 bg-white/7 p-4 backdrop-blur-md shadow-[0_20px_60px_rgba(2,6,23,0.24)]">
            <div class="text-2xl font-bold text-white">Velocidad</div>
            <div class="text-sm text-slate-300">menos fricción, menos vueltas y contacto más rápido</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-bg {
    background-image: url('/images/hero/optimized/nicho-digital-hero-premium-1024.webp');
    background-repeat: no-repeat;
    background-size: cover;
    background-position: left center;
    transform: scale(1.02);
    will-change: transform, background-position;
  }

  .hero-overlay {
    background: linear-gradient(90deg, rgba(7, 17, 38, 0.40) 0%, rgba(7, 17, 38, 0.34) 34%, rgba(7, 17, 38, 0.52) 68%, rgba(7, 17, 38, 0.66) 100%);
  }

  .hero-glow {
    background:
      radial-gradient(circle at 18% 34%, rgba(34, 211, 238, 0.16) 0%, rgba(34, 211, 238, 0.08) 14%, rgba(34, 211, 238, 0.02) 28%, transparent 46%),
      radial-gradient(circle at 22% 30%, rgba(59, 130, 246, 0.12) 0%, transparent 34%);
    mix-blend-mode: screen;
  }

  @media (max-width: 1023px) {
    .hero-bg {
      transform: scale(1.04);
      background-position: 22% center;
    }
  }

  @media (max-width: 767px) {
    .hero-bg {
      transform: scale(1.01);
      background-position: 28% center;
    }

    .hero-overlay {
      background: linear-gradient(180deg, rgba(7, 17, 38, 0.44) 0%, rgba(7, 17, 38, 0.50) 48%, rgba(7, 17, 38, 0.68) 100%);
    }

    .hero-glow {
      background:
        radial-gradient(circle at 26% 24%, rgba(34, 211, 238, 0.12) 0%, rgba(34, 211, 238, 0.05) 18%, transparent 38%),
        radial-gradient(circle at 22% 24%, rgba(59, 130, 246, 0.10) 0%, transparent 30%);
    }
  }
</style>

<script>
  const setupHeroParallax = () => {
    const hero = document.querySelector('.hero-section');
    const bg = hero?.querySelector('.hero-bg');
    if (!hero || !bg) return;

    const updateParallax = () => {
      const rect = hero.getBoundingClientRect();
      const offset = Math.max(-24, Math.min(24, rect.top * -0.06));
      bg.style.transform = `translate3d(0, ${offset}px, 0) scale(${window.innerWidth < 768 ? 1.01 : window.innerWidth < 1024 ? 1.04 : 1.02})`;
    };

    updateParallax();
    window.addEventListener('scroll', updateParallax, { passive: true });
    window.addEventListener('resize', updateParallax);
  };

  setupHeroParallax();
  document.addEventListener('astro:page-load', setupHeroParallax);
</script>
