---
import {
  ArrowRight,
  BarChart3,
  MessageCircle,
  MonitorSmartphone,
  ShieldCheck,
  Smartphone,
  Zap,
} from 'lucide-astro';

const benefits = [
  {
    icon: ShieldCheck,
    title: 'Diseño profesional',
    text: 'Sitios modernos centrados en confianza.',
  },
  {
    icon: Zap,
    title: 'Rápidos y optimizados',
    text: 'Velocidad, SEO y rendimiento desde el inicio.',
  },
  {
    icon: Smartphone,
    title: '100% responsivos',
    text: 'Perfectos en móviles, tablets y desktop.',
  },
  {
    icon: BarChart3,
    title: 'Enfocados en resultados',
    text: 'Estrategia digital para atraer y convertir.',
  },
];
---

<section id="inicio" class="relative overflow-hidden bg-[#030816] px-6 pt-28 text-white md:pt-32">
  <div class="absolute inset-0" aria-hidden="true">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_78%_28%,rgba(14,165,233,0.28),transparent_30%),radial-gradient(circle_at_16%_18%,rgba(34,211,238,0.16),transparent_24%),linear-gradient(180deg,#030816_0%,#071126_58%,#030816_100%)]"></div>
    <div class="absolute right-[-12%] top-20 h-72 w-72 rounded-full border border-cyan-400/15"></div>
    <div class="absolute bottom-16 right-0 h-px w-[58vw] rotate-[-18deg] bg-gradient-to-r from-transparent via-cyan-300/40 to-transparent"></div>
    <div class="absolute bottom-36 right-[-8vw] h-px w-[72vw] rotate-[-10deg] bg-gradient-to-r from-transparent via-blue-500/40 to-transparent"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl">
    <div class="grid min-h-[calc(100vh-7rem)] items-center gap-12 pb-10 lg:grid-cols-[0.94fr_1.06fr] lg:gap-16">
      <div class="max-w-2xl">
        <span data-reveal class="mb-6 inline-flex items-center gap-2 rounded-full border border-cyan-300/20 bg-cyan-300/10 px-4 py-2 text-sm font-semibold text-cyan-100 shadow-[0_0_30px_rgba(34,211,238,0.12)] backdrop-blur">
          <MonitorSmartphone class="h-4 w-4" />
          Agencia digital especializada
        </span>

        <h1 data-reveal data-reveal-delay="0.06" class="max-w-2xl text-4xl font-bold leading-[1.06] tracking-tight text-white md:text-6xl">
          Diseñamos sitios web que <span class="text-cyan-300">generan confianza</span> y atraen clientes
        </h1>

        <p data-reveal data-reveal-delay="0.12" class="mt-7 max-w-xl text-base leading-relaxed text-slate-300 md:text-lg">
          Creamos páginas web estratégicas, rápidas y visualmente impactantes para profesionales y negocios que quieren destacar en su nicho.
        </p>

        <div data-reveal data-reveal-delay="0.18" class="mt-8 flex flex-col gap-4 sm:flex-row">
          <a href="#entregables" class="inline-flex items-center justify-center gap-3 rounded-xl bg-cyan-400 px-6 py-3.5 font-semibold text-slate-950 shadow-[0_18px_48px_rgba(34,211,238,0.22)] transition hover:bg-cyan-300">
            Ver servicios
            <ArrowRight class="h-5 w-5" />
          </a>
          <a href="https://wa.me/593984710898?text=Hola%2C%20quiero%20una%20web%20premium%20para%20mi%20nicho" class="inline-flex items-center justify-center gap-3 rounded-xl border border-cyan-300/20 bg-slate-950/50 px-6 py-3.5 font-semibold text-white backdrop-blur transition hover:border-cyan-300/40 hover:bg-cyan-300/10">
            <MessageCircle class="h-5 w-5 text-cyan-300" />
            Escríbenos por WhatsApp
          </a>
        </div>
      </div>

      <div data-reveal data-reveal-delay="0.16" class="relative mx-auto w-full max-w-2xl lg:max-w-none">
        <div class="absolute inset-x-10 bottom-[-18px] h-16 rounded-full bg-cyan-400/20 blur-3xl"></div>

        <div class="relative ml-auto w-full max-w-[690px]">
          <div class="laptop-shell relative rounded-[28px] border border-white/18 bg-slate-950/80 p-3 shadow-[0_34px_110px_rgba(15,118,255,0.28)] backdrop-blur-xl">
            <div class="rounded-[20px] border border-white/10 bg-[#08152c] p-3">
              <div class="mb-3 flex items-center justify-between rounded-t-[14px] border border-white/8 bg-white/5 px-4 py-3">
                <div class="flex items-center gap-2">
                  <span class="h-2.5 w-2.5 rounded-full bg-cyan-300"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-blue-400"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-slate-500"></span>
                </div>
                <div class="h-2 w-28 rounded-full bg-white/16"></div>
                <div class="h-5 w-14 rounded-full bg-cyan-400/80"></div>
              </div>

              <div class="overflow-hidden rounded-b-[14px] bg-white">
                <div class="relative h-40 overflow-hidden bg-[#071126] sm:h-52">
                  <div class="absolute inset-0 bg-[radial-gradient(circle_at_78%_34%,rgba(34,211,238,0.30),transparent_32%),linear-gradient(135deg,#071126,#0f2a4d_52%,#020617)]"></div>
                  <div class="absolute bottom-[-12px] right-8 h-28 w-56 rotate-[-8deg] rounded-[50%] border border-cyan-300/20"></div>
                  <div class="relative p-6">
                    <div class="h-3 w-36 rounded-full bg-white/22"></div>
                    <div class="mt-5 h-4 w-56 rounded-full bg-white/35"></div>
                    <div class="mt-3 h-3 w-44 rounded-full bg-white/18"></div>
                    <div class="mt-5 h-8 w-28 rounded-lg bg-cyan-400"></div>
                  </div>
                </div>

                <div class="grid grid-cols-3 gap-4 bg-slate-50 p-5">
                  {['', '', ''].map(() => (
                    <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                      <div class="mx-auto mb-3 h-9 w-9 rounded-full bg-cyan-100"></div>
                      <div class="mx-auto h-2 w-20 rounded-full bg-slate-300"></div>
                      <div class="mx-auto mt-2 h-2 w-14 rounded-full bg-slate-200"></div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <div class="absolute -right-2 bottom-[-22px] w-[30%] min-w-[128px] max-w-[190px] rounded-[28px] border border-white/22 bg-slate-950 p-2 shadow-[0_28px_80px_rgba(2,6,23,0.55)] sm:-right-5 sm:bottom-[-34px]">
            <div class="rounded-[22px] border border-white/10 bg-white p-2">
              <div class="overflow-hidden rounded-[18px] bg-slate-50">
                <div class="h-28 bg-[radial-gradient(circle_at_70%_30%,rgba(34,211,238,0.30),transparent_36%),linear-gradient(135deg,#071126,#0f2a4d)] p-4">
                  <div class="h-2 w-16 rounded-full bg-white/28"></div>
                  <div class="mt-5 h-3 w-20 rounded-full bg-white/45"></div>
                  <div class="mt-3 h-7 w-16 rounded-lg bg-cyan-400"></div>
                </div>
                <div class="grid grid-cols-2 gap-2 p-3">
                  {['', '', '', ''].map(() => (
                    <div class="rounded-xl bg-white p-2 shadow-sm">
                      <div class="mx-auto h-5 w-5 rounded-full bg-cyan-100"></div>
                      <div class="mx-auto mt-2 h-1.5 w-8 rounded-full bg-slate-300"></div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div data-reveal data-reveal-delay="0.24" class="relative z-20 -mb-10 grid overflow-hidden rounded-2xl border border-cyan-300/14 bg-slate-950/78 shadow-[0_26px_80px_rgba(2,6,23,0.42)] backdrop-blur-xl sm:grid-cols-2 lg:grid-cols-4">
      {benefits.map((item, index) => {
        const Icon = item.icon;
        return (
          <div class:list={['flex gap-4 p-5 md:p-6', index > 0 ? 'border-t border-white/8 sm:border-t-0 lg:border-l' : '', index === 2 ? 'sm:border-l-0 lg:border-l' : '']}>
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-cyan-400/10 text-cyan-300 shadow-[0_0_34px_rgba(34,211,238,0.16)]">
              <Icon class="h-7 w-7" />
            </div>
            <div>
              <h2 class="text-sm font-bold text-white">{item.title}</h2>
              <p class="mt-1 text-sm leading-relaxed text-slate-300">{item.text}</p>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .laptop-shell::after {
    position: absolute;
    right: 9%;
    bottom: -20px;
    left: 13%;
    height: 22px;
    content: '';
    border-radius: 0 0 28px 28px;
    background: linear-gradient(180deg, rgba(51, 65, 85, 0.95), rgba(15, 23, 42, 0.96));
    box-shadow: 0 22px 52px rgba(2, 6, 23, 0.5);
  }

  @media (max-width: 640px) {
    .laptop-shell::after {
      bottom: -14px;
      height: 16px;
    }
  }
</style>
