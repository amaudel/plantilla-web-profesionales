---
import {
  ArrowRight,
  BarChart3,
  MessageCircle,
  MonitorSmartphone,
  ShieldCheck,
  Smartphone,
  Zap,
} from 'lucide-astro';

const benefits = [
  {
    icon: ShieldCheck,
    title: 'Diseño + copy',
    text: 'Mensaje claro, visual premium y CTA directo.',
  },
  {
    icon: Zap,
    title: 'Entrega rápida',
    text: 'Landing desde 7 días cuando el contenido está listo.',
  },
  {
    icon: Smartphone,
    title: 'Lista para vender',
    text: 'Optimizada para móvil, WhatsApp y campañas.',
  },
  {
    icon: BarChart3,
    title: 'SEO base incluido',
    text: 'Dominio, metadata, sitemap y rendimiento cuidados.',
  },
];

const whatsappUrl = 'https://wa.me/593984710898?text=Hola%2C%20quiero%20saber%20qu%C3%A9%20web%20necesita%20mi%20negocio';
---

<section id="inicio" data-hero-scroll class="relative isolate [overflow-x:clip] [overflow-y:visible] bg-[#030816] px-6 pt-24 text-white md:pt-28">
  <picture data-hero-visual class="hero-visual absolute inset-0 -z-20 block" aria-hidden="true">
    <source
      type="image/avif"
      srcset="/images/hero/optimized/nixgo-digital-experience-v2-512.avif 512w, /images/hero/optimized/nixgo-digital-experience-v2-1024.avif 1024w, /images/hero/optimized/nixgo-digital-experience-v2-1280.avif 1280w, /images/hero/optimized/nixgo-digital-experience-v2-1672.avif 1672w"
      sizes="100vw"
    />
    <source
      type="image/webp"
      srcset="/images/hero/optimized/nixgo-digital-experience-v2-512.webp 512w, /images/hero/optimized/nixgo-digital-experience-v2-1024.webp 1024w, /images/hero/optimized/nixgo-digital-experience-v2-1280.webp 1280w, /images/hero/optimized/nixgo-digital-experience-v2-1672.webp 1672w"
      sizes="100vw"
    />
    <img
      src="/images/hero/nixgo-digital-experience-v2.jpg"
      alt=""
      width="1672"
      height="940"
      class="h-full w-full object-cover object-[64%_center] md:object-center"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </picture>

  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(3,8,22,0.96)_0%,rgba(3,8,22,0.84)_30%,rgba(3,8,22,0.34)_55%,rgba(3,8,22,0.00)_78%)]"></div>
    <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(3,8,22,0.35)_0%,rgba(3,8,22,0.06)_42%,rgba(3,8,22,0.18)_100%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_18%_24%,rgba(34,211,238,0.12),transparent_26%)]"></div>
    <div data-hero-glow class="hero-glow absolute -right-[8%] top-[18%] h-[24rem] w-[24rem] rounded-full bg-cyan-300/[0.08] blur-3xl"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl">
    <div class="flex min-h-[34rem] items-center pb-8 pt-8 md:min-h-[31rem] lg:pb-10">
      <div class="max-w-2xl">
        <span data-hero-reveal class="mb-5 inline-flex items-center gap-2 rounded-full border border-cyan-300/20 bg-cyan-300/10 px-4 py-2 text-sm font-semibold text-cyan-100 shadow-[0_0_22px_rgba(34,211,238,0.10)] md:mb-6">
          <MonitorSmartphone class="h-4 w-4" />
          Webs desde USD 199 para negocios de servicios
        </span>

        <h1 data-hero-reveal class="max-w-2xl text-4xl font-bold leading-[1.06] tracking-tight text-white [text-shadow:0_2px_24px_rgba(2,6,23,0.74)] md:text-6xl">
          Tu web debe <span class="text-cyan-300 [text-shadow:0_0_28px_rgba(34,211,238,0.38)]">explicar tu valor</span> antes de que el cliente te escriba
        </h1>

        <p data-hero-reveal class="mt-5 max-w-xl text-base leading-relaxed text-slate-200 [text-shadow:0_2px_18px_rgba(2,6,23,0.78)] md:mt-7 md:text-lg">
          En Nixgo Digital creamos páginas rápidas, visuales y orientadas a WhatsApp para médicos, abogados, consultores y negocios que necesitan verse más confiables y recibir consultas mejor preparadas.
        </p>

        <div data-hero-reveal class="mt-6 flex flex-col gap-3 sm:flex-row md:mt-8 md:gap-4">
          <a href={whatsappUrl} class="inline-flex items-center justify-center gap-3 rounded-xl bg-cyan-400 px-6 py-3.5 font-semibold text-slate-950 shadow-[0_18px_48px_rgba(34,211,238,0.22)] transition hover:bg-cyan-300">
            Pedir diagnóstico por WhatsApp
            <ArrowRight class="h-5 w-5" />
          </a>
          <a href="#paquetes" class="inline-flex items-center justify-center gap-3 rounded-xl border border-cyan-300/20 bg-slate-950/70 px-6 py-3.5 font-semibold text-white transition hover:border-cyan-300/40 hover:bg-cyan-300/10">
            <MessageCircle class="h-5 w-5 text-cyan-300" />
            Ver paquetes
          </a>
        </div>

        <p data-hero-reveal class="mt-4 text-sm font-medium text-slate-300">
          Recibe una recomendación clara sobre paquete, mensaje y próximos pasos para lanzar tu web.
          <a href="#portfolio" class="ml-1 text-cyan-200 underline decoration-cyan-300/40 underline-offset-4 transition hover:text-cyan-100">
            Ver caso real: Dr. Raúl Vintimilla.
          </a>
        </p>
      </div>

    </div>

    <div class="relative z-20 grid gap-3 pb-6 sm:grid-cols-2 lg:-mb-8 lg:grid-cols-4">
      {benefits.map((item, index) => {
        const Icon = item.icon;
        return (
          <div data-hero-reveal class="relative flex min-h-[7rem] items-center gap-4 rounded-2xl bg-[#07152a]/92 px-5 py-5 shadow-[0_10px_28px_rgba(2,6,23,0.20)] ring-1 ring-cyan-300/10 [contain:paint] md:px-6">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-cyan-300/10 text-cyan-300 ring-1 ring-cyan-300/15">
              <Icon class="h-7 w-7 stroke-[1.7]" />
            </div>
            <div class="min-w-0">
              <h2 class="text-sm font-bold leading-snug text-white">{item.title}</h2>
              <p class="mt-1.5 text-sm leading-relaxed text-slate-300">{item.text}</p>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .hero-visual {
    transform: translate3d(0, calc(var(--hero-progress, 0) * 20px), 0) scale(calc(1.035 + var(--hero-progress, 0) * 0.025));
    transform-origin: center right;
    will-change: transform;
  }

  .hero-glow {
    opacity: calc(0.6 + var(--hero-progress, 0) * 0.4);
    transform: translate3d(calc(var(--hero-progress, 0) * -32px), calc(var(--hero-progress, 0) * 18px), 0);
    will-change: transform, opacity;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-visual,
    .hero-glow {
      transform: none;
      will-change: auto;
    }
  }
</style>

<script>
  let heroFrame;

  const setupHeroScroll = () => {
    const hero = document.querySelector('[data-hero-scroll]');
    if (!(hero instanceof HTMLElement) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const update = () => {
      const rect = hero.getBoundingClientRect();
      const distance = Math.max(hero.offsetHeight, 1);
      const progress = Math.min(1, Math.max(0, -rect.top / distance));
      hero.style.setProperty('--hero-progress', progress.toFixed(3));
      heroFrame = undefined;
    };

    const requestUpdate = () => {
      if (heroFrame) return;
      heroFrame = window.requestAnimationFrame(update);
    };

    update();
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate, { passive: true });

    document.addEventListener('astro:before-swap', () => {
      window.removeEventListener('scroll', requestUpdate);
      window.removeEventListener('resize', requestUpdate);
      if (heroFrame) window.cancelAnimationFrame(heroFrame);
    }, { once: true });
  };

  setupHeroScroll();
  document.addEventListener('astro:page-load', setupHeroScroll);
</script>
