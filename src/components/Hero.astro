---
import { BriefcaseBusiness, MessageCircle, Phone } from 'lucide-astro';
---

<section id="inicio" class="hero-section relative min-h-[90vh] md:min-h-screen overflow-hidden bg-[#071126] text-white">
  <picture class="hero-bg absolute inset-0" aria-hidden="true">
    <source
      type="image/avif"
      srcset="/images/hero/optimized/nicho-digital-hero-premium-512.avif 512w, /images/hero/optimized/nicho-digital-hero-premium-1024.avif 1024w"
      sizes="100vw"
    />
    <source
      type="image/webp"
      srcset="/images/hero/optimized/nicho-digital-hero-premium-512.webp 512w, /images/hero/optimized/nicho-digital-hero-premium-1024.webp 1024w"
      sizes="100vw"
    />
    <img
      src="/images/hero/optimized/nicho-digital-hero-premium-1024.png"
      srcset="/images/hero/optimized/nicho-digital-hero-premium-512.png 512w, /images/hero/optimized/nicho-digital-hero-premium-1024.png 1024w"
      sizes="100vw"
      width="1024"
      height="1024"
      alt=""
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </picture>
  <div class="hero-overlay absolute inset-0" aria-hidden="true"></div>
  <div class="hero-glow absolute inset-0" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto flex min-h-[90vh] md:min-h-screen max-w-7xl items-center px-6 pt-28 pb-16 md:pt-32 md:pb-20">
    <div class="grid w-full items-center gap-10 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="hidden lg:block">
        <div data-reveal data-float-soft class="max-w-sm rounded-[32px] border border-white/10 bg-slate-950/32 p-5 shadow-[0_30px_80px_rgba(2,6,23,0.28)] backdrop-blur-xl">
          <div class="mb-4 rounded-[24px] border border-white/10 bg-white/8 p-5">
            <div class="mb-2 text-sm font-semibold uppercase tracking-[0.18em] text-cyan-100">Sistema de venta</div>
            <div class="text-2xl font-bold leading-tight text-white">Estrategia, copy y diseño trabajando juntos</div>
          </div>
          <div class="grid gap-3">
            <div class="rounded-2xl bg-white/8 px-4 py-3 text-sm text-slate-200">01 · Mensaje adaptado al nicho</div>
            <div class="rounded-2xl bg-white/8 px-4 py-3 text-sm text-slate-200">02 · Jerarquía visual premium</div>
            <div class="rounded-2xl bg-white/8 px-4 py-3 text-sm text-slate-200">03 · WhatsApp como acción principal</div>
          </div>
        </div>
      </div>
      <div class="w-full lg:flex lg:justify-end">
        <div class="max-w-2xl text-left">
        <span data-reveal class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/8 px-4 py-1.5 text-sm font-medium text-blue-100 backdrop-blur-md">
          <BriefcaseBusiness class="h-4 w-4" />
          Nicho Digital · webs que elevan la percepción de tu servicio
        </span>

        <h1 data-reveal data-reveal-delay="0.08" class="mb-6 text-4xl font-bold leading-tight text-white md:text-6xl">
          Una web premium para que tu servicio se vea más confiable
          <span class="text-cyan-300"> y genere más consultas</span>
        </h1>

        <p data-reveal data-reveal-delay="0.16" class="mb-8 max-w-xl text-lg leading-relaxed text-slate-200 md:text-xl">
          Creamos webs para profesionales y negocios de servicios que venden confianza: médicos, abogados, psicólogos, consultores y marcas premium que necesitan explicar mejor su valor antes de que el cliente escriba.
        </p>

        <div data-reveal data-reveal-delay="0.22" class="mb-10 flex flex-col gap-4 sm:flex-row">
          <a href="#contacto" class="inline-flex items-center justify-center gap-2 rounded-xl bg-cyan-400 px-6 py-3 font-semibold text-slate-950 transition hover:bg-cyan-300">
            <MessageCircle class="h-5 w-5" />
            Pedir propuesta por WhatsApp
          </a>
          <a href="#nichos" class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/15 bg-white/6 px-6 py-3 font-medium text-white backdrop-blur-sm transition hover:bg-white/12">
            <Phone class="h-5 w-5" />
            Ver nichos
          </a>
        </div>

        <div class="grid gap-3 sm:grid-cols-3">
          <div data-reveal data-reveal-delay="0.05" class="rounded-2xl border border-white/10 bg-white/7 p-4 backdrop-blur-md shadow-[0_20px_60px_rgba(2,6,23,0.24)]">
            <div class="mb-1 text-xs font-semibold uppercase tracking-[0.18em] text-cyan-200">01</div>
            <div class="text-xl font-bold text-white">Nicho</div>
            <div class="text-sm text-slate-300">mensaje adaptado</div>
          </div>
          <div data-reveal data-reveal-delay="0.11" class="rounded-2xl border border-white/10 bg-white/7 p-4 backdrop-blur-md shadow-[0_20px_60px_rgba(2,6,23,0.24)]">
            <div class="mb-1 text-xs font-semibold uppercase tracking-[0.18em] text-cyan-200">02</div>
            <div class="text-xl font-bold text-white">Valor</div>
            <div class="text-sm text-slate-300">oferta clara</div>
          </div>
          <div data-reveal data-reveal-delay="0.17" class="rounded-2xl border border-white/10 bg-white/7 p-4 backdrop-blur-md shadow-[0_20px_60px_rgba(2,6,23,0.24)]">
            <div class="mb-1 text-xs font-semibold uppercase tracking-[0.18em] text-cyan-200">03</div>
            <div class="text-xl font-bold text-white">Consulta</div>
            <div class="text-sm text-slate-300">CTA directo</div>
          </div>
        </div>
      </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-bg,
  .hero-bg img {
    display: block;
  }

  .hero-bg img {
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: left center;
    transform: scale(1.02);
    will-change: transform;
  }

  .hero-overlay {
    background: linear-gradient(90deg, rgba(7, 17, 38, 0.48) 0%, rgba(7, 17, 38, 0.30) 32%, rgba(7, 17, 38, 0.55) 68%, rgba(7, 17, 38, 0.70) 100%);
  }

  .hero-glow {
    background:
      radial-gradient(circle at 18% 34%, rgba(34, 211, 238, 0.16) 0%, rgba(34, 211, 238, 0.08) 14%, rgba(34, 211, 238, 0.02) 28%, transparent 46%),
      radial-gradient(circle at 22% 30%, rgba(59, 130, 246, 0.12) 0%, transparent 34%);
    mix-blend-mode: screen;
  }

  @media (max-width: 1023px) {
    .hero-bg img {
      transform: scale(1.04);
      object-position: 22% center;
    }
  }

  @media (max-width: 767px) {
    .hero-bg img {
      transform: scale(1.01);
      object-position: 28% center;
    }

    .hero-overlay {
      background: linear-gradient(180deg, rgba(7, 17, 38, 0.44) 0%, rgba(7, 17, 38, 0.50) 48%, rgba(7, 17, 38, 0.68) 100%);
    }

    .hero-glow {
      background:
        radial-gradient(circle at 26% 24%, rgba(34, 211, 238, 0.12) 0%, rgba(34, 211, 238, 0.05) 18%, transparent 38%),
        radial-gradient(circle at 22% 24%, rgba(59, 130, 246, 0.10) 0%, transparent 30%);
    }
  }
</style>

<script>
  const setupHeroParallax = () => {
    const hero = document.querySelector('.hero-section');
    const bg = hero?.querySelector('.hero-bg img');
    if (!hero || !bg) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const updateParallax = () => {
      const rect = hero.getBoundingClientRect();
      const offset = Math.max(-24, Math.min(24, rect.top * -0.06));
      bg.style.transform = `translate3d(0, ${offset}px, 0) scale(${window.innerWidth < 768 ? 1.01 : window.innerWidth < 1024 ? 1.04 : 1.02})`;
    };

    updateParallax();
    window.addEventListener('scroll', updateParallax, { passive: true });
    window.addEventListener('resize', updateParallax);
  };

  setupHeroParallax();
  document.addEventListener('astro:page-load', setupHeroParallax);
</script>
