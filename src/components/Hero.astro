---
import {
  ArrowRight,
  BarChart3,
  MessageCircle,
  MonitorSmartphone,
  ShieldCheck,
  Smartphone,
  Zap,
} from 'lucide-astro';

const benefits = [
  {
    icon: ShieldCheck,
    title: 'Oferta clara',
    text: 'Qué vendes, para quién y por qué confiar.',
  },
  {
    icon: Zap,
    title: 'Entrega ágil',
    text: 'Landing desde 7 días con contenido listo.',
  },
  {
    icon: Smartphone,
    title: 'WhatsApp primero',
    text: 'CTA visible para recibir consultas preparadas.',
  },
  {
    icon: BarChart3,
    title: 'SEO base incluido',
    text: 'Metadata, sitemap, velocidad e indexación base.',
  },
];

const diagnosticUrl = '#diagnostico';

const heroFrames = Array.from(
  { length: 11 },
  (_, index) => `/hero-scroll/nixgodigital/frame_${String(index + 1).padStart(3, '0')}.webp`
);
---

<section id="inicio" data-hero-scroll class="relative isolate [overflow-x:clip] [overflow-y:visible] bg-[#030816] px-6 pt-24 text-white md:pt-28">
  <div data-hero-visual class="hero-visual absolute inset-0 -z-20 overflow-hidden" aria-hidden="true">
    <canvas data-hero-frame-canvas class="hero-frame-canvas absolute inset-0 h-full w-full opacity-0 transition-opacity duration-500"></canvas>
    <img
      data-hero-frame-fallback
      src={heroFrames[0]}
      alt=""
      width="1920"
      height="1080"
      class="hero-frame-fallback h-full w-full object-contain object-[center_bottom] transition-opacity duration-500 md:object-[right_center]"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </div>

  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(3,8,22,0.98)_0%,rgba(3,8,22,0.92)_30%,rgba(3,8,22,0.48)_55%,rgba(3,8,22,0.00)_78%)]"></div>
    <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(3,8,22,0.35)_0%,rgba(3,8,22,0.06)_42%,rgba(3,8,22,0.18)_100%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_18%_24%,rgba(34,211,238,0.12),transparent_26%)]"></div>
    <div data-hero-glow class="hero-glow absolute -right-[8%] top-[18%] h-[24rem] w-[24rem] rounded-full bg-cyan-300/[0.08] blur-3xl"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl">
    <div class="flex min-h-[34rem] items-center pb-8 pt-8 md:min-h-[31rem] lg:pb-10">
      <div class="max-w-2xl">
        <span data-hero-reveal class="mb-5 inline-flex items-center gap-2 rounded-full border border-cyan-300/20 bg-cyan-300/10 px-4 py-2 text-sm font-semibold text-cyan-100 shadow-[0_0_22px_rgba(34,211,238,0.10)] md:mb-6">
          <MonitorSmartphone class="h-4 w-4" />
          Webs premium para profesionales y negocios de servicios
        </span>

        <h1 data-hero-reveal class="max-w-2xl text-4xl font-bold leading-[1.06] tracking-tight text-white [text-shadow:0_2px_24px_rgba(2,6,23,0.74)] md:text-6xl">
          Nixgo Digital crea webs que <span class="text-cyan-300 [text-shadow:0_0_28px_rgba(34,211,238,0.38)]">explican tu valor</span> y generan más consultas
        </h1>

        <p data-hero-reveal class="mt-5 max-w-xl text-base leading-relaxed text-slate-200 [text-shadow:0_2px_18px_rgba(2,6,23,0.78)] md:mt-7 md:text-lg">
          Diseñamos páginas web para médicos, abogados, psicólogos, clínicas, consultores y negocios de servicios que necesitan verse más confiables, ordenar su oferta y convertir visitas en conversaciones por WhatsApp.
        </p>

        <div data-hero-reveal class="mt-6 flex flex-col gap-3 sm:flex-row md:mt-8 md:gap-4">
          <a href={diagnosticUrl} data-track="hero_diagnostic" class="inline-flex items-center justify-center gap-3 rounded-xl bg-cyan-400 px-6 py-3.5 font-semibold text-slate-950 shadow-[0_18px_48px_rgba(34,211,238,0.22)] transition hover:bg-cyan-300">
            Iniciar diagnóstico gratuito
            <ArrowRight class="h-5 w-5" />
          </a>
          <a href="#paquetes" class="inline-flex items-center justify-center gap-3 rounded-xl border border-cyan-300/20 bg-slate-950/70 px-6 py-3.5 font-semibold text-white transition hover:border-cyan-300/40 hover:bg-cyan-300/10">
            <MessageCircle class="h-5 w-5 text-cyan-300" />
            Ver paquetes
          </a>
        </div>

        <p data-hero-reveal class="mt-4 text-sm font-medium text-slate-300">
          Recibe una recomendación concreta sobre paquete, mensaje, estructura y próximos pasos para lanzar o mejorar tu web.
          <a href="#portfolio" class="ml-1 text-cyan-200 underline decoration-cyan-300/40 underline-offset-4 transition hover:text-cyan-100">
            Ver caso real: Dr. Raúl Vintimilla.
          </a>
        </p>
      </div>

    </div>

    <div class="relative z-20 grid gap-3 pb-6 sm:grid-cols-2 lg:-mb-8 lg:grid-cols-4">
      {benefits.map((item, index) => {
        const Icon = item.icon;
        return (
          <div data-hero-reveal class="relative flex min-h-[7rem] items-center gap-4 rounded-2xl bg-[#07152a]/92 px-5 py-5 shadow-[0_10px_28px_rgba(2,6,23,0.20)] ring-1 ring-cyan-300/10 [contain:paint] md:px-6">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-cyan-300/10 text-cyan-300 ring-1 ring-cyan-300/15">
              <Icon class="h-7 w-7 stroke-[1.7]" />
            </div>
            <div class="min-w-0">
              <h2 class="text-sm font-bold leading-snug text-white">{item.title}</h2>
              <p class="mt-1.5 text-sm leading-relaxed text-slate-300">{item.text}</p>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .hero-visual {
    transform: translate3d(0, calc(var(--hero-progress, 0) * 14px), 0) scale(calc(1.005 + var(--hero-progress, 0) * 0.012));
    transform-origin: center right;
    will-change: transform;
  }

  .hero-frame-fallback {
    box-sizing: border-box;
    padding: 12.5rem 0 2.5rem 50%;
  }

  .hero-glow {
    opacity: calc(0.6 + var(--hero-progress, 0) * 0.4);
    transform: translate3d(calc(var(--hero-progress, 0) * -32px), calc(var(--hero-progress, 0) * 18px), 0);
    will-change: transform, opacity;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-visual,
    .hero-glow {
      transform: none;
      will-change: auto;
    }
  }

  @media (max-width: 767px) {
    .hero-frame-fallback {
      padding: 23rem 0 1.5rem;
      opacity: 0.45;
    }
  }
</style>

<script define:vars={{ heroFrames }}>
  let heroFrame;

  const setupHeroScroll = () => {
    const hero = document.querySelector('[data-hero-scroll]');
    if (!(hero instanceof HTMLElement)) return;
    if (hero.dataset.heroScrollReady === 'true') return;
    hero.dataset.heroScrollReady = 'true';

    const canvas = hero.querySelector('[data-hero-frame-canvas]');
    const fallback = hero.querySelector('[data-hero-frame-fallback]');
    const context = canvas instanceof HTMLCanvasElement ? canvas.getContext('2d') : null;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const loadedFrames = [];
    let frameIndex = -1;
    let resizeFrame;

    const drawHeroFrame = (image) => {
      if (!(canvas instanceof HTMLCanvasElement) || !context || !image) return;

      const rect = canvas.getBoundingClientRect();
      const ratio = window.devicePixelRatio || 1;
      const width = Math.max(1, Math.round(rect.width * ratio));
      const height = Math.max(1, Math.round(rect.height * ratio));

      if (canvas.width !== width || canvas.height !== height) {
        canvas.width = width;
        canvas.height = height;
      }

      const isDesktop = window.innerWidth >= 1024;
      const isTablet = window.innerWidth >= 768 && window.innerWidth < 1024;
      const visualLeft = isDesktop ? width * 0.50 : isTablet ? width * 0.38 : 0;
      const visualWidth = width - visualLeft;
      const topPad = isDesktop ? height * 0.18 : isTablet ? height * 0.22 : height * 0.44;
      const bottomPad = isDesktop ? height * 0.08 : isTablet ? height * 0.08 : height * 0.05;
      const visualHeight = Math.max(1, height - topPad - bottomPad);
      const scale = Math.min(visualWidth / image.naturalWidth, visualHeight / image.naturalHeight) * (isDesktop ? 0.9 : isTablet ? 0.88 : 0.9);
      const drawWidth = image.naturalWidth * scale;
      const drawHeight = image.naturalHeight * scale;
      const x = visualLeft + Math.max(0, visualWidth - drawWidth);
      const y = topPad + Math.max(0, visualHeight - drawHeight) * (isDesktop ? 0.42 : 0.5);

      context.clearRect(0, 0, width, height);
      context.drawImage(image, x, y, drawWidth, drawHeight);
    };

    const drawFrame = (progress) => {
      if (!context || !loadedFrames.length) return;

      const nextIndex = Math.min(
        loadedFrames.length - 1,
        Math.max(0, Math.round(progress * (loadedFrames.length - 1)))
      );

      if (nextIndex === frameIndex) return;
      frameIndex = nextIndex;
      drawHeroFrame(loadedFrames[nextIndex]);
    };

    const preloadFrames = async () => {
      const images = await Promise.all(
        heroFrames.map((src) => new Promise((resolve) => {
          const image = new Image();
          image.decoding = 'async';
          image.onload = () => resolve(image);
          image.onerror = () => resolve(undefined);
          image.src = src;
        }))
      );

      loadedFrames.splice(0, loadedFrames.length, ...images.filter(Boolean));
      if (!loadedFrames.length) return;

      drawFrame(Number(hero.style.getPropertyValue('--hero-progress')) || 0);
      if (canvas instanceof HTMLCanvasElement) canvas.classList.remove('opacity-0');
      if (fallback instanceof HTMLImageElement) fallback.classList.add('opacity-0');
    };

    const update = () => {
      const rect = hero.getBoundingClientRect();
      const distance = Math.max(hero.offsetHeight, 1);
      const progress = Math.min(1, Math.max(0, -rect.top / distance));
      hero.style.setProperty('--hero-progress', progress.toFixed(3));
      if (!reduceMotion) drawFrame(progress);
      heroFrame = undefined;
    };

    const requestUpdate = () => {
      if (heroFrame) return;
      heroFrame = window.requestAnimationFrame(update);
    };

    update();
    if (!reduceMotion) void preloadFrames();

    const requestResize = () => {
      if (resizeFrame) return;
      resizeFrame = window.requestAnimationFrame(() => {
        resizeFrame = undefined;
        frameIndex = -1;
        requestUpdate();
      });
    };

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestResize, { passive: true });

    document.addEventListener('astro:before-swap', () => {
      delete hero.dataset.heroScrollReady;
      window.removeEventListener('scroll', requestUpdate);
      window.removeEventListener('resize', requestResize);
      if (heroFrame) window.cancelAnimationFrame(heroFrame);
      if (resizeFrame) window.cancelAnimationFrame(resizeFrame);
    }, { once: true });
  };

  setupHeroScroll();
  document.addEventListener('astro:page-load', setupHeroScroll);
</script>
