---
import {
  ArrowRight,
  BarChart3,
  MessageCircle,
  MonitorSmartphone,
  ShieldCheck,
  Smartphone,
  Zap,
} from 'lucide-astro';

const benefits = [
  {
    icon: ShieldCheck,
    title: 'Diseño profesional',
    text: 'Sitios modernos centrados en confianza.',
  },
  {
    icon: Zap,
    title: 'Rápidos y optimizados',
    text: 'Velocidad, SEO y rendimiento desde el inicio.',
  },
  {
    icon: Smartphone,
    title: '100% responsivos',
    text: 'Perfectos en móviles, tablets y desktop.',
  },
  {
    icon: BarChart3,
    title: 'Enfocados en resultados',
    text: 'Estrategia digital para atraer y convertir.',
  },
];
---

<section id="inicio" class="relative overflow-x-hidden bg-[#030816] px-6 pt-24 text-white md:pt-32">
  <div class="absolute inset-0" aria-hidden="true">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_78%_28%,rgba(14,165,233,0.28),transparent_30%),radial-gradient(circle_at_16%_18%,rgba(34,211,238,0.16),transparent_24%),linear-gradient(180deg,#030816_0%,#071126_58%,#030816_100%)]"></div>
    <div class="absolute right-[-12%] top-20 h-72 w-72 rounded-full border border-cyan-400/15"></div>
    <div class="absolute bottom-16 right-0 h-px w-[58vw] rotate-[-18deg] bg-gradient-to-r from-transparent via-cyan-300/40 to-transparent"></div>
    <div class="absolute bottom-36 right-[-8vw] h-px w-[72vw] rotate-[-10deg] bg-gradient-to-r from-transparent via-blue-500/40 to-transparent"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl">
    <div class="grid items-center gap-2 pb-8 lg:min-h-[calc(100vh-7rem)] lg:grid-cols-[0.94fr_1.06fr] lg:gap-16 lg:pb-10">
      <div class="max-w-2xl">
        <span data-reveal class="mb-5 inline-flex items-center gap-2 rounded-full border border-cyan-300/20 bg-cyan-300/10 px-4 py-2 text-sm font-semibold text-cyan-100 shadow-[0_0_30px_rgba(34,211,238,0.12)] backdrop-blur md:mb-6">
          <MonitorSmartphone class="h-4 w-4" />
          Agencia digital especializada
        </span>

        <h1 data-reveal data-reveal-delay="0.06" class="max-w-2xl text-4xl font-bold leading-[1.06] tracking-tight text-white md:text-6xl">
          Diseñamos sitios web que <span class="text-cyan-300">generan confianza</span> y atraen clientes
        </h1>

        <p data-reveal data-reveal-delay="0.12" class="mt-5 max-w-xl text-base leading-relaxed text-slate-300 md:mt-7 md:text-lg">
          Creamos páginas web estratégicas, rápidas y visualmente impactantes para profesionales y negocios que quieren destacar en su nicho.
        </p>

        <div data-reveal data-reveal-delay="0.18" class="mt-6 flex flex-col gap-3 sm:flex-row md:mt-8 md:gap-4">
          <a href="#entregables" class="inline-flex items-center justify-center gap-3 rounded-xl bg-cyan-400 px-6 py-3.5 font-semibold text-slate-950 shadow-[0_18px_48px_rgba(34,211,238,0.22)] transition hover:bg-cyan-300">
            Ver servicios
            <ArrowRight class="h-5 w-5" />
          </a>
          <a href="https://wa.me/593984710898?text=Hola%2C%20quiero%20una%20web%20premium%20para%20mi%20nicho" class="inline-flex items-center justify-center gap-3 rounded-xl border border-cyan-300/20 bg-slate-950/50 px-6 py-3.5 font-semibold text-white backdrop-blur transition hover:border-cyan-300/40 hover:bg-cyan-300/10">
            <MessageCircle class="h-5 w-5 text-cyan-300" />
            Escríbenos por WhatsApp
          </a>
        </div>
      </div>

      <div data-reveal data-reveal-delay="0.16" class="relative -mx-6 -mt-2 w-[calc(100%+3rem)] overflow-hidden sm:mx-auto sm:mt-1 sm:w-full sm:max-w-2xl lg:mt-0 lg:max-w-none">
        <div class="absolute inset-x-8 bottom-10 h-20 rounded-full bg-cyan-400/18 blur-3xl"></div>
        <div class="absolute right-8 top-12 h-56 w-56 rounded-full bg-blue-500/14 blur-3xl"></div>

        <picture class="relative block">
          <source
            type="image/avif"
            srcset="/images/hero/optimized/nicho-digital-hero-device-system-512.avif 512w, /images/hero/optimized/nicho-digital-hero-device-system-1024.avif 1024w"
            sizes="(min-width: 1024px) 54vw, 100vw"
          />
          <source
            type="image/webp"
            srcset="/images/hero/optimized/nicho-digital-hero-device-system-512.webp 512w, /images/hero/optimized/nicho-digital-hero-device-system-1024.webp 1024w"
            sizes="(min-width: 1024px) 54vw, 100vw"
          />
          <img
            src="/images/hero/nicho-digital-hero-device-system.jpg"
            alt="Mockup premium de sitio web responsive con paneles digitales y WhatsApp"
            width="1280"
            height="819"
            class="hero-device-image w-[220%] max-w-none -translate-x-[38%] object-contain drop-shadow-[0_38px_90px_rgba(14,165,233,0.22)] sm:ml-auto sm:w-full sm:max-w-[760px] sm:translate-x-0"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </picture>
      </div>
    </div>

    <div data-reveal data-reveal-delay="0.24" class="relative z-20 grid overflow-hidden rounded-2xl border border-cyan-300/14 bg-slate-950/78 shadow-[0_26px_80px_rgba(2,6,23,0.42)] backdrop-blur-xl sm:grid-cols-2 lg:-mb-10 lg:grid-cols-4">
      {benefits.map((item, index) => {
        const Icon = item.icon;
        return (
          <div class:list={['flex gap-4 p-5 md:p-6', index > 0 ? 'border-t border-white/8 sm:border-t-0 lg:border-l' : '', index === 2 ? 'sm:border-l-0 lg:border-l' : '']}>
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-cyan-400/10 text-cyan-300 shadow-[0_0_34px_rgba(34,211,238,0.16)]">
              <Icon class="h-7 w-7" />
            </div>
            <div>
              <h2 class="text-sm font-bold text-white">{item.title}</h2>
              <p class="mt-1 text-sm leading-relaxed text-slate-300">{item.text}</p>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
