---
import { ChevronDown } from 'lucide-astro';

const faqs = [
  {
    question: '¿Qué te tengo que enviar para empezar?',
    answer: 'Tu servicio principal, el tipo de cliente que quieres atraer, datos de contacto y cualquier foto, logo o referencia que ya tengas. Si no tienes textos, los ordenamos desde cero.',
  },
  {
    question: '¿La web queda lista con dominio y WhatsApp?',
    answer: 'Sí. Se entrega lista para compartir, con estructura, copy, diseño, metadata básica, CTA a WhatsApp y configuración del dominio cuando ya lo tienes comprado.',
  },
  {
    question: '¿Qué paquete me conviene?',
    answer: 'Si tienes una oferta puntual, Landing Profesional. Si necesitas presentar varios servicios y generar más confianza, Web Profesional. Si vendes tickets altos, Web Premium.',
  },
  {
    question: '¿También escribes los textos?',
    answer: 'Sí. El copy forma parte del trabajo: ordenamos el mensaje para que tu servicio se entienda rápido, genere confianza y lleve a más personas hacia WhatsApp.',
  },
  {
    question: '¿Puedo ajustar la web después?',
    answer: 'Sí. Después de publicarla puedes usarla en redes, campañas o WhatsApp y ajustar el mensaje según las primeras conversaciones reales.',
  },
];
---

<section id="faq" class="py-24 px-6 bg-gradient-to-b from-white to-gray-50 dark:from-gray-900 dark:to-gray-800 transition-colors duration-300">
  <div class="max-w-4xl mx-auto">
    <div data-reveal class="text-center mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 text-sm font-medium mb-4">FAQ</span>
      <h2 class="text-4xl md:text-5xl font-bold bg-gradient-to-r from-blue-500 to-blue-700 dark:from-blue-400 dark:to-blue-600 text-transparent bg-clip-text mb-4">
        Dudas antes de empezar
      </h2>
      <p class="text-xl text-gray-600 dark:text-gray-300">
        Respuestas rápidas para decidir si tiene sentido avanzar.
      </p>
    </div>

    <div class="space-y-6">
      {faqs.map((faq, index) => (
        <div data-reveal data-reveal-delay={String(Math.min(index * 0.04, 0.16))} class="faq-item bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden transition-all duration-200 hover:shadow-md">
          <button type="button" class="w-full flex items-center justify-between p-6 text-left group" aria-expanded="false" aria-controls={`faq-answer-${index}`}>
            <span class="text-lg font-semibold text-gray-900 dark:text-white group-hover:text-blue-500 dark:group-hover:text-blue-400 transition-colors">{faq.question}</span>
            <ChevronDown className="w-5 h-5 text-blue-500 dark:text-blue-400 transition-transform duration-200" />
          </button>
          <div id={`faq-answer-${index}`} class="faq-content hidden">
            <div class="px-6 pb-6 text-gray-600 dark:text-gray-300">{faq.answer}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function setupFAQ() {
    const faqItems = document.querySelectorAll('.faq-item');
    faqItems.forEach(item => {
      const button = item.querySelector('button');
      const content = item.querySelector('.faq-content');
      const icon = button?.querySelector('svg');
      if (button && content && icon) {
        button.onclick = () => {
          const isExpanded = button.getAttribute('aria-expanded') === 'true';
          faqItems.forEach(otherItem => {
            const otherContent = otherItem.querySelector('.faq-content');
            const otherButton = otherItem.querySelector('button');
            const otherIcon = otherItem.querySelector('svg');
            if (otherContent && otherButton && otherIcon) {
              otherContent.classList.add('hidden');
              otherButton.setAttribute('aria-expanded', 'false');
              otherIcon.style.transform = 'rotate(0deg)';
            }
          });
          if (!isExpanded) {
            content.classList.remove('hidden');
            button.setAttribute('aria-expanded', 'true');
            icon.style.transform = 'rotate(180deg)';
          }
        };
      }
    });
  }
  setupFAQ();
  document.addEventListener('astro:page-load', setupFAQ);
</script>
