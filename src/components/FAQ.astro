---
import { ChevronDown } from 'lucide-astro';

const faqs = [
  {
    question: '¿Qué necesito tener listo para empezar?',
    answer: 'Lo mínimo: qué servicio quieres vender, a quién quieres atraer y cómo prefieres que te contacten. Si no tienes textos, los ordenamos desde cero.',
  },
  {
    question: '¿La web queda lista para publicar?',
    answer: 'Sí. La idea es entregar una web lista para compartir, con estructura, copy, diseño, metadata básica y CTA directo a WhatsApp o el canal que elijas.',
  },
  {
    question: '¿Puedo empezar con una landing y luego ampliar?',
    answer: 'Sí. Puedes empezar con una página enfocada en una oferta y después convertirla en una web más completa con casos, más servicios y más secciones.',
  },
  {
    question: '¿También ayudas con el texto?',
    answer: 'Sí. El copy forma parte del trabajo: ordenamos el mensaje para que tu cliente entienda tu valor, reduzca dudas y sepa cómo avanzar.',
  },
  {
    question: '¿Qué pasa después de publicar?',
    answer: 'Puedes usar la web en redes, campañas, tarjetas digitales o WhatsApp. A partir de las primeras conversaciones, se puede ajustar el mensaje para mejorar conversión.',
  },
];
---

<section id="faq" class="py-24 px-6 bg-gradient-to-b from-white to-gray-50 dark:from-gray-900 dark:to-gray-800 transition-colors duration-300">
  <div class="max-w-4xl mx-auto">
    <div data-reveal class="text-center mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 text-sm font-medium mb-4">FAQ</span>
      <h2 class="text-4xl md:text-5xl font-bold bg-gradient-to-r from-blue-500 to-blue-700 dark:from-blue-400 dark:to-blue-600 text-transparent bg-clip-text mb-4">
        Preguntas frecuentes
      </h2>
      <p class="text-xl text-gray-600 dark:text-gray-300">
        Objeciones típicas antes de encargar una web comercial.
      </p>
    </div>

    <div class="space-y-6">
      {faqs.map((faq, index) => (
        <div data-reveal data-reveal-delay={String(Math.min(index * 0.04, 0.16))} class="faq-item bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden transition-all duration-200 hover:shadow-md">
          <button type="button" class="w-full flex items-center justify-between p-6 text-left group" aria-expanded="false">
            <span class="text-lg font-semibold text-gray-900 dark:text-white group-hover:text-blue-500 dark:group-hover:text-blue-400 transition-colors">{faq.question}</span>
            <ChevronDown className="w-5 h-5 text-blue-500 dark:text-blue-400 transition-transform duration-200" />
          </button>
          <div class="faq-content hidden">
            <div class="px-6 pb-6 text-gray-600 dark:text-gray-300">{faq.answer}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function setupFAQ() {
    const faqItems = document.querySelectorAll('.faq-item');
    faqItems.forEach(item => {
      const button = item.querySelector('button');
      const content = item.querySelector('.faq-content');
      const icon = button?.querySelector('svg');
      if (button && content && icon) {
        button.onclick = () => {
          const isExpanded = button.getAttribute('aria-expanded') === 'true';
          faqItems.forEach(otherItem => {
            const otherContent = otherItem.querySelector('.faq-content');
            const otherButton = otherItem.querySelector('button');
            const otherIcon = otherItem.querySelector('svg');
            if (otherContent && otherButton && otherIcon) {
              otherContent.classList.add('hidden');
              otherButton.setAttribute('aria-expanded', 'false');
              otherIcon.style.transform = 'rotate(0deg)';
            }
          });
          if (!isExpanded) {
            content.classList.remove('hidden');
            button.setAttribute('aria-expanded', 'true');
            icon.style.transform = 'rotate(180deg)';
          }
        };
      }
    });
  }
  setupFAQ();
</script>
