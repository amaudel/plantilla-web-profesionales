---
import { Github, LinkedinIcon, Menu, X, Sun, Moon, Facebook, Instagram } from 'lucide-react';
import XLogo from './XLogo.astro';
import Image from './Image.astro';
import { config } from '../config';

const currentPath = Astro.url.pathname;
const isHomePage = currentPath === '/';
const prefix = isHomePage ? '' : '/';
const companyName = config.app.name;
const { twitter, github, linkedin, facebook, instagram } = config.social;
const hasSocialLinks = twitter || github || linkedin || facebook || instagram;
const homePrefix = isHomePage ? '' : '/';
const links = [
  { href: `${homePrefix}#entregables`, label: 'Visuales' },
  { href: `${homePrefix}#nichos`, label: 'Sectores' },
  { href: `${homePrefix}#portfolio`, label: 'Caso' },
  { href: `${homePrefix}#paquetes`, label: 'Paquetes' },
  { href: '/medicos-cuenca', label: 'Médicos' },
  { href: `${homePrefix}#faq`, label: 'FAQ' },
  { href: `${homePrefix}#contacto`, label: 'Contacto' },
];
---

<nav class="fixed w-full z-50 transition-all duration-300 py-4" id="navbar">
  <div class="mx-auto flex h-full max-w-7xl items-center justify-between rounded-2xl border border-cyan-300/12 bg-[#030816]/84 px-3 shadow-[0_20px_60px_rgba(2,6,23,0.34)] backdrop-blur-xl md:px-6">
    <a href={prefix || '#inicio'} class="flex items-center space-x-1 px-3 py-3 text-white transition-all duration-300 hover:text-cyan-300 md:px-4">
      <div class="flex items-center gap-3">
        <Image src="/images/icon/logo.png" alt="Logo" width={32} height={32} class="w-9 h-9 rounded-xl" />
        <div class="flex flex-col leading-none">
          <span class="text-lg font-bold tracking-tight">{companyName}</span>
          <span class="text-[11px] uppercase tracking-[0.18em] text-cyan-200/70">Webs premium</span>
        </div>
      </div>
    </a>
    
    <div class="flex items-center gap-2 md:gap-8">
      <button id="theme-toggle" class="rounded-full p-2 text-slate-200 transition-all duration-300 hover:bg-white/8 hover:text-cyan-300" aria-label="Toggle theme">
        <Sun className="w-5 h-5 hidden dark:block" />
        <Moon className="w-5 h-5 block dark:hidden" />
      </button>
      
      <button id="menu-toggle" class="rounded-lg p-2 text-slate-100 transition-all duration-300 hover:bg-white/8 hover:text-cyan-300 md:hidden" aria-label="Toggle menu">
        <Menu className="w-6 h-6" id="menu-icon" />
        <X className="hidden w-6 h-6" id="close-icon" />
      </button>
      
      <div class="hidden md:flex items-center space-x-6 px-4">
        {links.map((link) => (
          <a href={link.href} class="text-sm font-medium text-slate-200 hover:text-cyan-300 transition-all duration-300">{link.label}</a>
        ))}
        {hasSocialLinks && <div class="h-4 w-px bg-white/12"></div>}
        {hasSocialLinks && (
          <div class="flex items-center space-x-4">
            {twitter && <a href={twitter} target="_blank" rel="noopener noreferrer" class="p-2 rounded-full text-slate-200 hover:text-cyan-300 transition-all duration-300 hover:bg-white/8" aria-label="Twitter Profile"><XLogo className="w-4 h-4" /></a>}
            {linkedin && <a href={linkedin} target="_blank" rel="noopener noreferrer" class="p-2 rounded-full text-slate-200 hover:text-cyan-300 transition-all duration-300 hover:bg-white/8" aria-label="LinkedIn Profile"><LinkedinIcon className="w-4 h-4" /></a>}
            {github && <a href={github} target="_blank" rel="noopener noreferrer" class="p-2 rounded-full text-slate-200 hover:text-cyan-300 transition-all duration-300 hover:bg-white/8" aria-label="GitHub Profile"><Github className="w-4 h-4" /></a>}
            {facebook && <a href={facebook} target="_blank" rel="noopener noreferrer" class="p-2 rounded-full text-slate-200 hover:text-cyan-300 transition-all duration-300 hover:bg-white/8" aria-label="Facebook Profile"><Facebook className="w-4 h-4" /></a>}
            {instagram && <a href={instagram} target="_blank" rel="noopener noreferrer" class="p-2 rounded-full text-slate-200 hover:text-cyan-300 transition-all duration-300 hover:bg-white/8" aria-label="Instagram Profile"><Instagram className="w-4 h-4" /></a>}
          </div>
        )}
      </div>
    </div>
  </div>
  
  <div id="mobile-menu" class="fixed inset-0 z-[9999] hidden overflow-y-auto bg-white px-6 pt-24 text-slate-950 dark:bg-slate-950 dark:text-white">
    <div class="absolute inset-x-0 top-0 h-44 bg-[radial-gradient(circle_at_top_left,_rgba(34,211,238,0.18),_transparent_36%)] dark:bg-[radial-gradient(circle_at_top_left,_rgba(34,211,238,0.16),_transparent_36%)]" id="menu-backdrop"></div>
    <div class="relative z-10 mx-auto max-w-md">
      <div class="mb-10 flex items-center gap-3">
        <Image src="/images/icon/logo.png" alt="Logo Nicho Digital" width={40} height={40} class="h-11 w-11 rounded-2xl" />
        <div>
          <div class="text-lg font-bold tracking-tight">{companyName}</div>
          <div class="text-xs uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">Webs premium</div>
        </div>
      </div>
      <div class="flex flex-col gap-3">
        {links.map((link) => (
          <a href={link.href} class="dark-mobile-link rounded-2xl border border-slate-200 bg-slate-50 px-5 py-4 text-xl font-semibold text-slate-900 transition hover:border-blue-200 hover:bg-blue-50 hover:text-blue-700 dark:border-slate-800 dark:bg-slate-900 dark:text-white dark:hover:border-cyan-400/30 dark:hover:bg-slate-900/80 dark:hover:text-cyan-200">{link.label}</a>
        ))}
      </div>
      <a href="#contacto" class="mt-8 inline-flex w-full justify-center rounded-2xl bg-blue-600 px-6 py-4 font-semibold text-white shadow-lg shadow-blue-500/20 transition hover:bg-blue-700">
        Pedir propuesta
      </a>
    </div>
    <button id="close-mobile-menu" class="dark-mobile-link absolute right-5 top-5 z-20 rounded-full border border-slate-200 bg-white p-3 text-slate-900 shadow-sm dark:border-slate-800 dark:bg-slate-900 dark:text-white" aria-label="Close menu">
      <X className="w-6 h-6" />
    </button>
  </div>
</nav>

<script>
  function setupThemeToggle() {
    const themeToggle = document.getElementById('theme-toggle');
    if (!themeToggle) return;
    const toggleTheme = () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateMobileMenuColors(isDark);
      window.dispatchEvent(new Event('themeChange'));
    };
    const newThemeToggle = themeToggle.cloneNode(true);
    if (themeToggle.parentNode) themeToggle.parentNode.replaceChild(newThemeToggle, themeToggle);
    newThemeToggle.addEventListener('click', toggleTheme);
    updateMobileMenuColors(document.documentElement.classList.contains('dark'));
  }
  function updateMobileMenuColors(isDark) {
    document.querySelectorAll('.dark-mobile-link').forEach(link => {
      link.classList.toggle('is-dark', isDark);
    });
  }
  function setupMobileMenu() {
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const closeButton = document.getElementById('close-mobile-menu');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');
    if (!menuToggle || !mobileMenu || !closeButton || !menuIcon || !closeIcon) return;
    function openMenu() { mobileMenu.style.display = 'block'; document.body.style.overflow = 'hidden'; menuIcon.classList.add('hidden'); closeIcon.classList.remove('hidden'); }
    function closeMenu() { mobileMenu.style.display = 'none'; document.body.style.overflow = ''; menuIcon.classList.remove('hidden'); closeIcon.classList.add('hidden'); }
    menuToggle.onclick = () => { openMenu(); return false; };
    closeButton.onclick = () => { closeMenu(); return false; };
    mobileMenu.querySelectorAll('a').forEach(link => { link.onclick = () => setTimeout(closeMenu, 100); });
    closeMenu();
  }
  function setupNavbarScroll() {
    const navbar = document.getElementById('navbar');
    const handleScroll = () => {
      if (window.scrollY > 50) navbar?.classList.add('py-3');
      else navbar?.classList.remove('py-3');
    };
    window.removeEventListener('scroll', handleScroll);
    window.addEventListener('scroll', handleScroll);
    handleScroll();
  }
  function initializeAll() {
    setupThemeToggle();
    setupMobileMenu();
    setupNavbarScroll();
  }
  initializeAll();
  document.addEventListener('astro:page-load', initializeAll);
</script>
