<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    [data-reveal-pending] {
      opacity: 0;
      transform: translate3d(0, var(--reveal-distance, 22px), 0);
    }

    [data-reveal-ready] {
      opacity: 1;
      transform: translate3d(0, 0, 0);
      transition:
        opacity 520ms ease,
        transform 620ms cubic-bezier(0.22, 1, 0.36, 1);
      transition-delay: var(--reveal-delay, 0ms);
      will-change: opacity, transform;
    }

    [data-reveal-done] {
      will-change: auto;
    }
  }
</style>

<script>
  let revealObserver;

  const revealElement = (element) => {
    element.removeAttribute('data-reveal-pending');
    element.setAttribute('data-reveal-ready', '');
    revealObserver?.unobserve(element);

    window.setTimeout(() => {
      element.setAttribute('data-reveal-done', '');
    }, 900);
  };

  const setupScrollAnimations = () => {
    const revealItems = Array.from(document.querySelectorAll('[data-reveal]'));

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
      revealItems.forEach(revealElement);
      return;
    }

    revealObserver?.disconnect();
    revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) revealElement(entry.target);
        });
      },
      {
        rootMargin: '0px 0px -8% 0px',
        threshold: 0.08,
      }
    );

    revealItems.forEach((element) => {
      const rect = element.getBoundingClientRect();
      const distance = Number(element.getAttribute('data-reveal-distance') || 22);
      const delay = Number(element.getAttribute('data-reveal-delay') || 0);

      element.style.setProperty('--reveal-distance', `${distance}px`);
      element.style.setProperty('--reveal-delay', `${Math.round(delay * 1000)}ms`);

      if (rect.top < window.innerHeight * 0.92) {
        revealElement(element);
        return;
      }

      element.setAttribute('data-reveal-pending', '');
      revealObserver.observe(element);
    });
  };

  setupScrollAnimations();
  document.addEventListener('astro:page-load', setupScrollAnimations);
  document.addEventListener('astro:before-swap', () => revealObserver?.disconnect());
</script>
