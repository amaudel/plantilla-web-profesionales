---
import { Sparkles } from 'lucide-astro';
import DiagnosticQuiz from './funnel/DiagnosticQuiz';
---

<section
  id="diagnostico"
  class="relative overflow-hidden bg-white px-6 py-24 dark:bg-slate-950"
>
  <div
    class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,_rgba(34,211,238,0.12),_transparent_28%),radial-gradient(circle_at_bottom_right,_rgba(37,99,235,0.10),_transparent_30%)]"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-7xl">
    <div class="mb-12 grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
      <div data-reveal>
        <span class="inline-flex items-center gap-2 rounded-full border border-blue-200/70 bg-blue-50 px-4 py-1.5 text-sm font-semibold text-blue-700 dark:border-cyan-400/20 dark:bg-cyan-300/10 dark:text-cyan-200">
          <Sparkles class="h-4 w-4" />
          Diagnóstico web gratuito
        </span>
        <h2 class="mt-5 text-3xl font-bold leading-tight tracking-tight text-slate-950 dark:text-white md:text-5xl">
          Descubre qué web necesita tu negocio antes de pedir una cotización
        </h2>
      </div>
      <p data-reveal data-reveal-delay="0.08" class="max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-300">
        Responde 5 preguntas rápidas y recibe una recomendación entre Landing Profesional,
        Web Profesional o Web Premium, con un mensaje de WhatsApp listo para enviar.
      </p>
    </div>

    <div data-reveal>
      <DiagnosticQuiz client:load />
    </div>
  </div>
</section>
