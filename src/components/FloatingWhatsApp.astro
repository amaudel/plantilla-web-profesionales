---
import { Icon } from 'astro-icon/components';

const whatsappUrl =
  'https://wa.me/593984710898?text=Hola%2C%20quiero%20una%20web%20premium%20para%20mi%20nicho';
---

<a
  data-whatsapp-float
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escribir por WhatsApp"
  title="Escribir por WhatsApp"
  class="whatsapp-float fixed bottom-4 right-4 z-[80] inline-flex h-12 w-12 items-center justify-center rounded-full bg-[#25D366] text-white shadow-[0_12px_28px_rgba(37,211,102,0.24)] ring-1 ring-white/30 transition-colors duration-200 hover:bg-[#1ebe5d] focus:outline-none focus:ring-4 focus:ring-[#25D366]/30 md:bottom-6 md:right-6 md:h-16 md:w-16"
>
  <span data-whatsapp-icon class="inline-flex items-center justify-center">
    <Icon name="tabler:brand-whatsapp" class="h-6 w-6 md:h-8 md:w-8" aria-hidden="true" />
  </span>
</a>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .whatsapp-float {
      animation: whatsapp-float 3.4s ease-in-out 0.8s infinite;
    }

    .whatsapp-float [data-whatsapp-icon] {
      animation: whatsapp-pulse 5.4s ease-in-out 1.2s infinite;
    }
  }

  @keyframes whatsapp-float {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(0, -5px, 0);
    }
  }

  @keyframes whatsapp-pulse {
    0%,
    88%,
    100% {
      transform: rotate(0deg) scale(1);
    }
    92% {
      transform: rotate(-7deg) scale(1.12);
    }
  }
</style>
