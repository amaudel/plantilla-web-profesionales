---
import { Icon } from 'astro-icon/components';

const whatsappUrl =
  'https://wa.me/593984710898?text=Hola%2C%20quiero%20una%20web%20premium%20para%20mi%20nicho';
---

<a
  data-whatsapp-float
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escribir por WhatsApp"
  title="Escribir por WhatsApp"
  class="fixed bottom-4 right-4 z-[80] inline-flex h-12 w-12 items-center justify-center rounded-full bg-[#25D366] text-white shadow-[0_18px_40px_rgba(37,211,102,0.32)] ring-1 ring-white/30 transition-colors duration-200 hover:bg-[#1ebe5d] focus:outline-none focus:ring-4 focus:ring-[#25D366]/30 md:bottom-6 md:right-6 md:h-16 md:w-16"
>
  <span data-whatsapp-icon class="inline-flex items-center justify-center">
    <Icon name="tabler:brand-whatsapp" class="h-6 w-6 md:h-8 md:w-8" aria-hidden="true" />
  </span>
</a>

<script>
  let whatsappAnimationCleanup;
  let loadingGsap;
  let gsapInstance;

  const loadGsap = async () => {
    if (gsapInstance) return gsapInstance;

    loadingGsap ||= import('gsap').then((gsapModule) => {
      gsapInstance = gsapModule.gsap;
      return gsapInstance;
    });

    return loadingGsap;
  };

  const setupWhatsAppAnimation = async () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const button = document.querySelector('[data-whatsapp-float]');
    const icon = document.querySelector('[data-whatsapp-icon]');
    if (!button || !icon) return;

    const gsap = await loadGsap();
    whatsappAnimationCleanup?.();

    const context = gsap.context(() => {
      gsap.fromTo(
        button,
        { autoAlpha: 0, y: 18, scale: 0.92 },
        { autoAlpha: 1, y: 0, scale: 1, duration: 0.55, ease: 'back.out(1.7)' }
      );

      gsap.to(button, {
        y: -6,
        duration: 2.4,
        delay: 0.55,
        ease: 'sine.inOut',
        repeat: -1,
        yoyo: true,
      });

      gsap.timeline({ repeat: -1, repeatDelay: 4.8 })
        .to(icon, { scale: 1.14, rotation: -8, duration: 0.16, ease: 'power2.out' })
        .to(icon, { scale: 1, rotation: 0, duration: 0.18, ease: 'power2.inOut' });
    });

    whatsappAnimationCleanup = () => context.revert();
  };

  setupWhatsAppAnimation();
  document.addEventListener('astro:page-load', setupWhatsAppAnimation);
  document.addEventListener('astro:before-swap', () => whatsappAnimationCleanup?.());
</script>
