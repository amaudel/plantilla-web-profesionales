---
import { Icon } from 'astro-icon/components';

const whatsappUrl =
  'https://wa.me/593984710898?text=Hola%2C%20quiero%20una%20web%20premium%20para%20mi%20nicho';
---

<a
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escribir por WhatsApp"
  title="Escribir por WhatsApp"
  class="fixed bottom-5 right-5 z-[80] inline-flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-[0_18px_40px_rgba(37,211,102,0.32)] ring-1 ring-white/30 transition duration-200 hover:-translate-y-0.5 hover:bg-[#1ebe5d] focus:outline-none focus:ring-4 focus:ring-[#25D366]/30 md:bottom-6 md:right-6 md:h-16 md:w-16"
>
  <Icon name="tabler:brand-whatsapp" class="h-7 w-7 md:h-8 md:w-8" aria-hidden="true" />
</a>
