---
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Problems from '../components/Problems.astro';
import NicheShowcase from '../components/NicheShowcase.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import Packages from '../components/Packages.astro';
import Profile from '../components/Profile.astro';
import SocialProof from '../components/SocialProof.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Nicho Digital | Webs premium para profesionales y negocios de servicios"
  description="Nicho Digital diseña webs premium para profesionales y negocios de servicios que necesitan verse mejor, generar confianza y vender con más velocidad."
>
  <Navbar />
  <Hero />
  <Problems />
  <NicheShowcase />
  <Services />
  <Process />
  <Packages />
  <Profile />
  <SocialProof />
  <FAQ />

  <section id="contacto" class="py-24 px-6 bg-gray-50 dark:bg-gray-900">
    <div class="max-w-4xl mx-auto text-center mb-10">
      <span class="inline-block px-4 py-1.5 rounded-full bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 text-sm font-medium mb-4">
        Contacto
      </span>
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
        Hablemos de la web que necesita tu negocio
      </h2>
      <p class="text-lg text-gray-600 dark:text-gray-300">
        Si quieres una web más clara, más profesional y pensada para ayudarte a vender sin perder tiempo, escríbeme.
      </p>
    </div>

    <div class="max-w-5xl mx-auto grid md:grid-cols-3 gap-4 mb-8">
      <div class="bg-white dark:bg-gray-800 rounded-xl border border-blue-100 dark:border-blue-900/30 p-5 text-center">
        <div class="text-sm text-gray-500 dark:text-gray-400 mb-1">WhatsApp</div>
        <a href="https://wa.me/593984710898?text=Hola%2C%20quiero%20una%20web%20premium%20para%20mi%20nicho" class="text-blue-600 dark:text-blue-400 font-semibold">098 471 0898</a>
      </div>
      <div class="bg-white dark:bg-gray-800 rounded-xl border border-blue-100 dark:border-blue-900/30 p-5 text-center">
        <div class="text-sm text-gray-500 dark:text-gray-400 mb-1">Ideal para</div>
        <div class="font-semibold text-gray-900 dark:text-white">Profesionales y negocios de servicios</div>
      </div>
      <div class="bg-white dark:bg-gray-800 rounded-xl border border-blue-100 dark:border-blue-900/30 p-5 text-center">
        <div class="text-sm text-gray-500 dark:text-gray-400 mb-1">Objetivo</div>
        <div class="font-semibold text-gray-900 dark:text-white">Más confianza, más rapidez comercial y más contactos</div>
      </div>
    </div>

    <div class="max-w-3xl mx-auto">
      <div class="rounded-3xl border border-green-100 dark:border-green-900/30 bg-white dark:bg-gray-800 p-8 md:p-10 shadow-sm text-center">
        <div class="text-sm uppercase tracking-[0.18em] text-green-600 dark:text-green-400 mb-3">Canal directo</div>
        <h3 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white mb-4">
          Escríbeme por WhatsApp y conversemos sobre tu web
        </h3>
        <p class="text-gray-600 dark:text-gray-300 mb-6 max-w-2xl mx-auto">
          Es la forma más rápida de revisar tu idea, tu sector y el tipo de web que necesitas sin perder tiempo en vueltas innecesarias.
        </p>
        <a href="https://wa.me/593984710898?text=Hola%2C%20quiero%20una%20web%20premium%20para%20mi%20nicho" class="inline-flex items-center rounded-xl bg-green-600 px-7 py-3 text-white font-semibold hover:bg-green-700 transition shadow-sm">
          Hablar por WhatsApp
        </a>
      </div>
    </div>
  </section>

  <FinalCTA />
  <Footer />
</Layout>
