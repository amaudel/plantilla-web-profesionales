---
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import NicheShowcase from '../components/NicheShowcase.astro';
import VisualBuildout from '../components/VisualBuildout.astro';
import PortfolioCase from '../components/PortfolioCase.astro';
import Packages from '../components/Packages.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import ScrollAnimations from '../components/ScrollAnimations.astro';
import Layout from '../layouts/Layout.astro';
import {
  CalendarDays,
  Clock3,
  Globe2,
  MapPin,
  MessageCircle,
  Phone,
  Send,
  ShieldCheck,
  Sparkles,
  Star,
  Zap,
} from 'lucide-astro';

const whatsappText = encodeURIComponent(
  'Hola, quiero una web premium para mi nicho'
);
const whatsappUrl = `https://wa.me/593984710898?text=${whatsappText}`;
---

<Layout
  title="Nicho Digital | Webs premium para profesionales y negocios de servicios"
  description="Nicho Digital crea webs premium para profesionales que quieren verse más confiables, explicar mejor su valor y recibir más consultas por WhatsApp."
>
  <Navbar />
  <Hero />
  <VisualBuildout />
  <NicheShowcase />
  <PortfolioCase />
  <Packages />
  <FAQ />

  <section id="contacto" class="relative overflow-hidden bg-[#030816] px-5 py-24 text-white md:px-6">
    <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(15,23,42,0.15),rgba(3,8,22,0.95))]"></div>
    <div class="relative mx-auto max-w-6xl">
      <div class="overflow-hidden rounded-[30px] border border-blue-300/15 bg-[#071225]/95 shadow-[0_28px_80px_rgba(0,0,0,0.34)]">
        <div class="grid gap-0 lg:grid-cols-[1.55fr_1fr]">
          <div class="p-5 md:p-8">
            <div class="grid gap-6 md:grid-cols-[230px_1fr] md:items-start">
              <div class="relative min-h-[250px] overflow-hidden rounded-[22px] border border-white/10 bg-[linear-gradient(145deg,#102744,#071225)] p-5">
                <div class="absolute inset-x-0 top-0 h-24 bg-cyan-300/10"></div>
                <div class="relative flex h-full min-h-[210px] flex-col justify-between">
                  <div class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-blue-500 text-white shadow-lg shadow-blue-500/30">
                    <Sparkles class="h-7 w-7" />
                  </div>
                  <div>
                    <div class="text-2xl font-bold leading-none">Nicho</div>
                    <div class="text-2xl font-bold leading-none text-cyan-200">Digital</div>
                    <div class="mt-3 max-w-[11rem] text-sm leading-relaxed text-slate-300">
                      Webs premium para servicios profesionales.
                    </div>
                  </div>
                  <div class="inline-flex w-fit items-center gap-2 rounded-xl border border-white/10 bg-white/10 px-3 py-2 text-sm text-slate-100">
                    <ShieldCheck class="h-4 w-4 text-cyan-200" />
                    Estrategia + diseño
                  </div>
                </div>
              </div>

              <div>
                <div class="flex flex-wrap items-center gap-3">
                  <h2 class="text-3xl font-bold leading-tight md:text-4xl">
                    Cuéntame tu idea y revisamos qué web te conviene
                  </h2>
                  <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-blue-500 text-white">
                    <ShieldCheck class="h-4 w-4" />
                  </span>
                </div>
                <p class="mt-3 text-base leading-relaxed text-slate-300 md:text-lg">
                  Sin formularios largos. Te respondo por WhatsApp, revisamos tu sector y aterrizamos una estructura clara para vender mejor.
                </p>

                <div class="mt-5 flex flex-wrap items-center gap-3 text-sm text-slate-300">
                  <span class="inline-flex items-center gap-1.5 text-amber-300">
                    <Star class="h-4 w-4 fill-current" />
                    <Star class="h-4 w-4 fill-current" />
                    <Star class="h-4 w-4 fill-current" />
                    <Star class="h-4 w-4 fill-current" />
                    <Star class="h-4 w-4 fill-current" />
                  </span>
                  <span class="font-semibold text-white">5.0</span>
                  <span class="h-4 w-px bg-white/14"></span>
                  <span>respuesta directa</span>
                </div>

                <div class="mt-6 flex flex-wrap gap-3">
                  <span class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/7 px-4 py-3 text-sm text-slate-200">
                    <MapPin class="h-4 w-4 text-cyan-300" />
                    Cuenca, Ecuador
                  </span>
                  <span class="inline-flex items-center gap-2 rounded-xl border border-emerald-400/20 bg-emerald-400/10 px-4 py-3 text-sm text-emerald-100">
                    <span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span>
                    Disponible hoy
                  </span>
                </div>

                <div class="mt-7 grid gap-3 sm:grid-cols-3">
                  <a href="tel:+593984710898" class="inline-flex min-h-[68px] items-center gap-3 rounded-2xl border border-blue-300/25 bg-blue-600 px-4 py-3 font-semibold text-white shadow-lg shadow-blue-600/20 transition hover:bg-blue-500">
                    <Phone class="h-6 w-6 shrink-0" />
                    <span>
                      <span class="block leading-tight">Llamar</span>
                      <span class="block text-xs font-medium text-blue-100">respuesta inmediata</span>
                    </span>
                  </a>
                  <a href={whatsappUrl} class="inline-flex min-h-[68px] items-center gap-3 rounded-2xl border border-emerald-300/25 bg-emerald-500 px-4 py-3 font-semibold text-white shadow-lg shadow-emerald-500/18 transition hover:bg-emerald-400">
                    <MessageCircle class="h-6 w-6 shrink-0" />
                    <span>
                      <span class="block leading-tight">WhatsApp</span>
                      <span class="block text-xs font-medium text-emerald-50">chat directo</span>
                    </span>
                  </a>
                  <a href={whatsappUrl} class="inline-flex min-h-[68px] items-center gap-3 rounded-2xl border border-cyan-300/25 bg-cyan-500 px-4 py-3 font-semibold text-white shadow-lg shadow-cyan-500/18 transition hover:bg-cyan-400">
                    <CalendarDays class="h-6 w-6 shrink-0" />
                    <span>
                      <span class="block leading-tight">Agendar</span>
                      <span class="block text-xs font-medium text-cyan-50">revisión rápida</span>
                    </span>
                  </a>
                </div>
              </div>
            </div>

            <div class="mt-6 grid gap-3 border-t border-white/10 pt-5 md:grid-cols-3">
              <div class="flex gap-3 rounded-2xl bg-white/5 p-4">
                <Clock3 class="mt-1 h-6 w-6 shrink-0 text-cyan-300" />
                <div>
                  <div class="font-semibold">Horario flexible</div>
                  <div class="mt-1 text-sm leading-relaxed text-slate-300">Lunes - Viernes · respuesta por WhatsApp</div>
                </div>
              </div>
              <div class="flex gap-3 rounded-2xl bg-white/5 p-4">
                <Zap class="mt-1 h-6 w-6 shrink-0 text-cyan-300" />
                <div>
                  <div class="font-semibold">Diagnóstico rápido</div>
                  <div class="mt-1 text-sm leading-relaxed text-slate-300">Idea, nicho y siguiente paso claro</div>
                </div>
              </div>
              <div class="flex gap-3 rounded-2xl bg-white/5 p-4">
                <Globe2 class="mt-1 h-6 w-6 shrink-0 text-cyan-300" />
                <div>
                  <div class="font-semibold">Web lista para vender</div>
                  <div class="mt-1 text-sm leading-relaxed text-slate-300">Diseño, copy, SEO base y CTA</div>
                </div>
              </div>
            </div>
          </div>

          <div class="border-t border-white/10 p-5 md:p-8 lg:border-l lg:border-t-0">
            <div class="relative min-h-[350px] overflow-hidden rounded-[24px] border border-blue-300/15 bg-[#08162a]">
              <div class="absolute inset-0 opacity-55 [background-image:linear-gradient(rgba(96,165,250,0.18)_1px,transparent_1px),linear-gradient(90deg,rgba(96,165,250,0.18)_1px,transparent_1px)] [background-size:34px_34px]"></div>
              <div class="absolute left-[-20%] top-[48%] h-24 w-[150%] rotate-[-18deg] bg-blue-500/20 blur-sm"></div>
              <div class="absolute left-[8%] top-[70%] h-16 w-[130%] rotate-[-35deg] bg-cyan-400/16 blur-sm"></div>

              <div class="relative m-5 max-w-[220px] rounded-2xl border border-white/10 bg-[#0b172b]/90 p-4">
                <div class="flex items-center gap-2 font-semibold">
                  <MapPin class="h-5 w-5 text-cyan-300" />
                  Nicho Digital
                </div>
                <div class="mt-2 text-sm leading-relaxed text-slate-300">
                  Estrategia, diseño y contacto directo para tu negocio.
                </div>
              </div>

              <div class="absolute left-1/2 top-1/2 flex h-24 w-24 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-blue-500/25">
                <div class="flex h-16 w-16 items-center justify-center rounded-full bg-blue-500 text-white shadow-[0_0_36px_rgba(59,130,246,0.75)]">
                  <MapPin class="h-8 w-8 fill-current" />
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="grid gap-3 border-t border-white/10 bg-[#050c1a] p-5 md:grid-cols-[220px_1fr_auto_auto] md:items-center">
          <div class="flex items-center gap-3">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-500 text-white">
              <Sparkles class="h-6 w-6" />
            </div>
            <div>
              <div class="font-semibold">Nicho Digital</div>
              <div class="text-sm text-emerald-300">En línea ahora</div>
            </div>
          </div>

          <a href={whatsappUrl} class="flex min-h-[54px] items-center justify-between gap-3 rounded-2xl border border-white/10 bg-white/8 px-5 text-sm text-slate-300 transition hover:bg-white/12">
            <span>Hola, quiero mejorar la web de mi negocio...</span>
            <Send class="h-5 w-5 shrink-0 text-cyan-300" />
          </a>

          <a href="#faq" class="inline-flex min-h-[46px] items-center justify-center gap-2 rounded-2xl border border-white/10 bg-white/8 px-4 text-sm font-semibold text-slate-200 transition hover:bg-white/12">
            Preguntas frecuentes
          </a>
          <a href="#paquetes" class="inline-flex min-h-[46px] items-center justify-center gap-2 rounded-2xl border border-white/10 bg-white/8 px-4 text-sm font-semibold text-slate-200 transition hover:bg-white/12">
            Paquetes
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
  <ScrollAnimations />
</Layout>
