---
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import NicheShowcase from '../components/NicheShowcase.astro';
import VisualBuildout from '../components/VisualBuildout.astro';
import Process from '../components/Process.astro';
import PortfolioCase from '../components/PortfolioCase.astro';
import DiagnosticFunnel from '../components/DiagnosticFunnel.astro';
import Packages from '../components/Packages.astro';
import ChatbotPackages from '../components/ChatbotPackages.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import ScrollAnimations from '../components/ScrollAnimations.astro';
import Layout from '../layouts/Layout.astro';
import { CalendarDays, MessageCircle, Phone, ShieldCheck } from 'lucide-astro';

const whatsappText = encodeURIComponent(
  'Hola, quiero un diagnóstico gratis para mejorar la web de mi negocio'
);
const whatsappUrl = `https://wa.me/593984710898?text=${whatsappText}`;
---

<Layout
  title="Nixgo Digital | Webs premium para profesionales y negocios de servicios"
  description="Nixgo Digital crea páginas web premium para médicos, abogados, psicólogos, consultores, clínicas y negocios de servicios que quieren verse más confiables y recibir más consultas por WhatsApp."
>
  <Navbar />
  <Hero />
  <VisualBuildout />
  <NicheShowcase />
  <Process />
  <PortfolioCase />
  <DiagnosticFunnel />
  <Packages />
  <ChatbotPackages />
  <FAQ />

  <section id="contacto" class="relative overflow-hidden bg-slate-950 px-6 py-24 text-white">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,_rgba(34,211,238,0.16),_transparent_28%),radial-gradient(circle_at_bottom_right,_rgba(37,99,235,0.24),_transparent_32%)]"></div>
    <div class="relative mx-auto grid max-w-6xl gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-stretch">
      <div data-reveal class="rounded-[34px] border border-white/10 bg-white/6 p-8 shadow-[0_30px_80px_rgba(2,6,23,0.34)] backdrop-blur-xl md:p-10">
        <span class="inline-block rounded-full border border-cyan-300/20 bg-cyan-300/10 px-4 py-1.5 text-sm font-semibold text-cyan-100">
          Contacto
        </span>
        <h2 class="mt-5 text-3xl font-bold leading-tight tracking-tight md:text-5xl">
          Cuéntanos qué vendes y revisamos qué web te conviene
        </h2>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-200">
          Revisamos tu sector, tu oferta y el tipo de cliente que quieres atraer. Recibes una recomendación clara: landing, web profesional o web premium.
        </p>

        <div class="mt-8 grid gap-3 sm:grid-cols-3">
          <a href="tel:+593984710898" class="group flex min-h-[126px] flex-col justify-between rounded-2xl border border-white/10 bg-slate-900/70 p-4 transition hover:border-blue-300/35 hover:bg-slate-900">
            <span class="flex items-start justify-between gap-3">
              <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-blue-500 text-white">
                <Phone class="h-5 w-5" />
              </span>
              <span class="rounded-full bg-white/8 px-2.5 py-1 text-xs font-semibold text-blue-100">01</span>
            </span>
            <span>
              <span class="block text-sm text-slate-300">Respuesta rápida</span>
              <span class="mt-1 block font-semibold text-white">Llamar directo</span>
            </span>
          </a>
          <a href={whatsappUrl} class="group flex min-h-[126px] flex-col justify-between rounded-2xl border border-emerald-300/20 bg-emerald-500/12 p-4 transition hover:border-emerald-300/45 hover:bg-emerald-500/16">
            <span class="flex items-start justify-between gap-3">
              <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-400 text-slate-950">
                <MessageCircle class="h-5 w-5" />
              </span>
              <span class="rounded-full bg-emerald-300/12 px-2.5 py-1 text-xs font-semibold text-emerald-100">02</span>
            </span>
            <span>
              <span class="block text-sm text-emerald-100/80">Chat sin formulario</span>
              <span class="mt-1 block font-semibold text-white">Enviar idea</span>
            </span>
          </a>
          <a href={whatsappUrl} class="group flex min-h-[126px] flex-col justify-between rounded-2xl border border-cyan-300/20 bg-cyan-500/12 p-4 transition hover:border-cyan-300/45 hover:bg-cyan-500/16">
            <span class="flex items-start justify-between gap-3">
              <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-cyan-300 text-slate-950">
                <CalendarDays class="h-5 w-5" />
              </span>
              <span class="rounded-full bg-cyan-300/12 px-2.5 py-1 text-xs font-semibold text-cyan-100">03</span>
            </span>
            <span>
              <span class="block text-sm text-cyan-100/80">Revisión de tu idea</span>
              <span class="mt-1 block font-semibold text-white">Pedir recomendación</span>
            </span>
          </a>
        </div>

        <div class="mt-5 flex flex-wrap gap-2 text-sm text-slate-300">
          <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/8 px-3 py-2">
            <ShieldCheck class="h-4 w-4 text-cyan-200" />
            Diagnóstico claro
          </span>
          <span class="inline-flex rounded-full border border-white/10 bg-white/8 px-3 py-2">
            Sin pasos innecesarios
          </span>
        </div>
      </div>

      <div data-reveal data-reveal-delay="0.1" class="rounded-[34px] border border-cyan-300/15 bg-[linear-gradient(160deg,rgba(37,99,235,0.94),rgba(8,47,73,0.96))] p-8 shadow-[0_30px_80px_rgba(37,99,235,0.26)] md:p-10">
        <div class="text-sm font-semibold uppercase tracking-[0.18em] text-cyan-100">Canal directo</div>
        <h3 class="mt-4 text-2xl font-bold tracking-tight md:text-3xl">
          Escríbenos y aterrizamos tu oferta
        </h3>
        <p class="mt-4 text-sky-100">
          Revisamos qué paquete encaja mejor, qué debería comunicar tu web y qué información hace falta para cotizar sin hacerte perder tiempo.
        </p>
        <div class="mt-7 space-y-3">
          <div class="rounded-2xl border border-white/10 bg-white/10 px-4 py-3">1. Nos cuentas qué vendes y a quién quieres atraer.</div>
          <div class="rounded-2xl border border-white/10 bg-white/10 px-4 py-3">2. Revisamos qué debe explicar tu web para generar confianza.</div>
          <div class="rounded-2xl border border-white/10 bg-white/10 px-4 py-3">3. Recibes el paquete más lógico para empezar.</div>
        </div>
        <a href={whatsappUrl} class="mt-8 inline-flex w-full items-center justify-center rounded-2xl bg-white px-7 py-3.5 font-semibold text-blue-700 shadow-lg shadow-cyan-500/10 transition hover:bg-blue-50">
          Hablar por WhatsApp
        </a>
      </div>
    </div>
  </section>

  <Footer />
  <ScrollAnimations />
</Layout>
