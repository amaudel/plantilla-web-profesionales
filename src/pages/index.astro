---
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Problems from '../components/Problems.astro';
import NicheShowcase from '../components/NicheShowcase.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import Profile from '../components/Profile.astro';
import SocialProof from '../components/SocialProof.astro';
import FAQ from '../components/FAQ.astro';
import ContactForm from '../components/ContactForm.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Webs premium para nichos específicos"
  description="Web comercial para vender webs premium por nicho con enfoque en claridad, percepción de valor y conversión."
>
  <Navbar />
  <Hero />
  <Problems />
  <NicheShowcase />
  <Services />
  <Process />
  <Profile />
  <SocialProof />
  <FAQ />

  <section id="contacto" class="py-24 px-6 bg-gray-50 dark:bg-gray-900">
    <div class="max-w-4xl mx-auto text-center mb-10">
      <span class="inline-block px-4 py-1.5 rounded-full bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-300 text-sm font-medium mb-4">
        Contacto
      </span>
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
        Hablemos de tu web, tu nicho o tu próxima demo comercial
      </h2>
      <p class="text-lg text-gray-600 dark:text-gray-300">
        Esta sección ya está pensada para convertir visitas en conversaciones reales por WhatsApp o formulario.
      </p>
    </div>

    <div class="max-w-5xl mx-auto grid md:grid-cols-3 gap-4 mb-8">
      <div class="bg-white dark:bg-gray-800 rounded-xl border border-blue-100 dark:border-blue-900/30 p-5 text-center">
        <div class="text-sm text-gray-500 dark:text-gray-400 mb-1">WhatsApp</div>
        <a href="https://wa.me/593999999999?text=Hola%2C%20quiero%20una%20web%20premium%20para%20mi%20nicho" class="text-blue-600 dark:text-blue-400 font-semibold">+593 99 999 9999</a>
      </div>
      <div class="bg-white dark:bg-gray-800 rounded-xl border border-blue-100 dark:border-blue-900/30 p-5 text-center">
        <div class="text-sm text-gray-500 dark:text-gray-400 mb-1">Enfoque</div>
        <div class="font-semibold text-gray-900 dark:text-white">Profesionales y negocios de servicios</div>
      </div>
      <div class="bg-white dark:bg-gray-800 rounded-xl border border-blue-100 dark:border-blue-900/30 p-5 text-center">
        <div class="text-sm text-gray-500 dark:text-gray-400 mb-1">Objetivo</div>
        <div class="font-semibold text-gray-900 dark:text-white">Más percepción de valor y más contactos</div>
      </div>
    </div>

    <div class="text-center mb-8">
      <a href="https://wa.me/593999999999?text=Hola%2C%20quiero%20una%20web%20premium%20para%20mi%20nicho" class="inline-flex items-center rounded-lg bg-green-600 px-6 py-3 text-white font-semibold hover:bg-green-700 transition">
        Hablar por WhatsApp
      </a>
    </div>

    <ContactForm />
  </section>

  <FinalCTA />
  <Footer />
</Layout>
