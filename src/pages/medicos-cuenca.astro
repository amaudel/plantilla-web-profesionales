const faqs = [
  {
    question: '¿Es solo una página web?',
    answer:
      'No. Incluye una web médica personal, mensajes claros para pacientes, SEO local, contacto directo y una estructura pensada para convertir búsquedas en conversaciones.',
  },
  {
    question: '¿Sirve si ya tengo Google Maps?',
    answer:
      'Sí. Google Maps da visibilidad, pero una web personal ayuda a explicar servicios, trayectoria, ubicación y motivos para agendar.',
  },
  {
    question: '¿Puedo usar una web demo antes de decidir?',
    answer:
      'Sí. Revisamos su especialidad y le mostramos qué estructura tendría una landing médica enfocada en pacientes privados.',
  },
];

const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};

const serviceStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Web médica personal y SEO local para médicos en Cuenca',
  provider: {
    '@type': 'Organization',
    name: 'Nixgo Digital',
    url: 'https://nixgodigital.com',
  },
  areaServed: {
    '@type': 'City',
    name: 'Cuenca',
    addressCountry: 'EC',
  },
  serviceType: 'diseño web médico, SEO local y optimización de Google Business Profile',
  description:
    'Landing médica personal, SEO local, copy de confianza y optimización de contacto para especialistas médicos en Cuenca.',
};
---

<Layout
  title="Web médica personal + SEO local para médicos en Cuenca | Nixgo Digital"
  description="Creamos páginas web médicas personales para especialistas en Cuenca: landing profesional, SEO local, Google Business Profile y CTA directo a WhatsApp."
  image="/images/portfolio/optimized/web-doctor-device-mockup-1024.png"
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceStructuredData)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />

  <style is:global>
    @media (max-width: 639px) {
      body.medical-funnel-complete > a.fixed[href^="https://wa.me"] {
        opacity: 0;
        pointer-events: none;
        transform: translateY(12px) scale(0.94);
      }
    }
  </style>

  <header class="fixed inset-x-0 top-0 z-50 px-3 py-2.5 md:px-4 md:py-4">
    <nav class="mx-auto flex max-w-7xl items-center justify-between rounded-2xl border border-white/12 bg-slate-950/78 px-3 py-2.5 text-white shadow-[0_20px_55px_rgba(2,6,23,0.18)] backdrop-blur-xl md:px-6 md:py-3">
      <a href="/" class="flex items-center gap-3">
        <img src="/images/icon/logo.png" alt="Nixgo Digital" class="h-8 w-8 rounded-lg md:h-10 md:w-10 md:rounded-xl" width="40" height="40" />
        <div>
          <div class="text-sm font-bold leading-none tracking-tight md:text-base">Nixgo Digital</div>
          <div class="mt-1 text-[9px] uppercase tracking-[0.16em] text-cyan-100/80 md:text-[11px] md:tracking-[0.18em]">Médicos en Cuenca</div>
        </div>
      </a>
      <div class="hidden items-center gap-6 text-sm font-medium text-slate-200 md:flex">
        <a href="#problema" class="transition hover:text-cyan-200">Problema</a>
        <a href="#diagnostico-medico" class="transition hover:text-cyan-200">Diagnóstico</a>
        <a href="#demo" class="transition hover:text-cyan-200">Demo</a>
        <a href="#paquetes" class="transition hover:text-cyan-200">Paquetes</a>
        <a href="#faq" class="transition hover:text-cyan-200">FAQ</a>
      </div>
      <a href={whatsappUrl} class="inline-flex items-center gap-2 rounded-xl bg-cyan-300 px-3 py-2 text-sm font-semibold text-slate-950 shadow-lg shadow-cyan-500/20 transition hover:bg-cyan-200 md:rounded-2xl md:px-4 md:py-2.5">
        <MessageCircle class="h-4 w-4" />
        Diagnóstico
      </a>
    </nav>
  </header>

  <main class="bg-white text-slate-950 dark:bg-slate-950 dark:text-white">
    <section id="inicio" class="relative isolate overflow-hidden bg-slate-950 px-6 pb-20 pt-36 text-white md:pb-28 md:pt-40">
      <div class="absolute inset-0 -z-10">
        <img
          src="/images/hero/optimized/nicho-digital-hero-premium-1024.webp"
          alt=""
          class="h-full w-full object-cover object-left opacity-34"
          width="1024"
          height="1024"
          loading="eager"
          decoding="async"
        />
        <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(2,6,23,0.92),rgba(2,6,23,0.74)_44%,rgba(8,47,73,0.70))]"></div>
      </div>

      <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[1.02fr_0.98fr] lg:items-center">
        <div data-reveal>
          <span class="inline-flex items-center gap-2 rounded-full border border-cyan-300/20 bg-cyan-300/10 px-4 py-2 text-sm font-semibold text-cyan-100">
            <Stethoscope class="h-4 w-4" />
            Web médica + SEO local
          </span>
          <h1 class="mt-6 max-w-4xl text-4xl font-bold leading-tight tracking-tight md:text-6xl">
            Web médica personal para que especialistas en Cuenca conviertan búsquedas en consultas
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-200 md:text-xl">
            Si ya tiene reputación, su web debe explicar mejor sus servicios, reforzar su marca personal y llevar pacientes hacia WhatsApp con menos fricción.
          </p>

          <div class="mt-8 flex flex-col gap-4 sm:flex-row">
            <a href="#diagnostico-medico" class="inline-flex items-center justify-center gap-2 rounded-2xl bg-cyan-300 px-6 py-3.5 font-semibold text-slate-950 shadow-lg shadow-cyan-500/20 transition hover:bg-cyan-200">
              Iniciar diagnóstico médico
              <ArrowRight class="h-5 w-5" />
            </a>
            <a href="#demo" class="inline-flex items-center justify-center gap-2 rounded-2xl border border-white/16 bg-white/8 px-6 py-3.5 font-semibold text-white backdrop-blur transition hover:bg-white/12">
              Ver ejemplo médico
            </a>
          </div>

          <div class="mt-10 grid max-w-2xl gap-3 sm:grid-cols-3">
            <div class="rounded-2xl border border-white/10 bg-white/8 p-4 backdrop-blur">
              <div class="text-2xl font-bold text-white">SEO</div>
              <div class="mt-1 text-sm text-slate-300">por especialidad y ciudad</div>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/8 p-4 backdrop-blur">
              <div class="text-2xl font-bold text-white">GBP</div>
              <div class="mt-1 text-sm text-slate-300">Google Business Profile</div>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/8 p-4 backdrop-blur">
              <div class="text-2xl font-bold text-white">CTA</div>
              <div class="mt-1 text-sm text-slate-300">WhatsApp y llamada</div>
            </div>
          </div>
        </div>

        <div data-reveal data-reveal-delay="0.12" class="relative">
          <div class="absolute -inset-6 rounded-[38px] bg-cyan-300/12 blur-3xl"></div>
          <div class="relative overflow-hidden rounded-[34px] border border-white/12 bg-white/10 p-4 shadow-[0_32px_90px_rgba(2,6,23,0.38)] backdrop-blur-xl">
            <div class="rounded-[26px] border border-white/10 bg-slate-950 p-3">
              <div class="mb-3 hidden items-center gap-2 px-2 sm:flex">
                <span class="h-3 w-3 rounded-full bg-red-400"></span>
                <span class="h-3 w-3 rounded-full bg-amber-400"></span>
                <span class="h-3 w-3 rounded-full bg-emerald-400"></span>
                <span class="ml-3 text-xs text-slate-400">demo médica optimizada</span>
              </div>
              <picture>
                <source
                  type="image/avif"
                  srcset="/images/portfolio/optimized/web-doctor-device-mockup-512.avif 512w, /images/portfolio/optimized/web-doctor-device-mockup-1024.avif 1024w"
                  sizes="(min-width: 1024px) 45vw, 100vw"
                />
                <source
                  type="image/webp"
                  srcset="/images/portfolio/optimized/web-doctor-device-mockup-512.webp 512w, /images/portfolio/optimized/web-doctor-device-mockup-1024.webp 1024w"
                  sizes="(min-width: 1024px) 45vw, 100vw"
                />
                <img
                  src="/images/portfolio/optimized/web-doctor-device-mockup-1024.png"
                  alt="Mockup de una landing médica personal optimizada para pacientes"
                  width="1024"
                  height="1024"
                  class="rounded-[20px] border border-white/10 object-cover"
                  loading="eager"
                  decoding="async"
                />
              </picture>
            </div>
            <div class="grid gap-3 pt-4 sm:grid-cols-3">
              <div class="rounded-2xl bg-white/10 p-4">
                <Search class="mb-3 h-5 w-5 text-cyan-200" />
                <div class="font-semibold">Búsqueda local</div>
              </div>
              <div class="rounded-2xl bg-white/10 p-4">
                <ShieldCheck class="mb-3 h-5 w-5 text-cyan-200" />
                <div class="font-semibold">Confianza médica</div>
              </div>
              <div class="rounded-2xl bg-white/10 p-4">
                <MessageCircle class="mb-3 h-5 w-5 text-cyan-200" />
                <div class="font-semibold">Agenda directa</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="problema" class="px-6 py-24">
      <div class="mx-auto max-w-7xl">
        <div data-reveal class="max-w-3xl">
          <span class="inline-flex rounded-full bg-blue-50 px-4 py-2 text-sm font-semibold text-blue-700 dark:bg-cyan-300/10 dark:text-cyan-200">El problema comercial</span>
          <h2 class="mt-5 text-3xl font-bold tracking-tight md:text-5xl">
            No se trata de tener una página bonita. Se trata de controlar cómo lo encuentra y evalúa el paciente.
          </h2>
        </div>

        <div class="mt-12 grid gap-6 lg:grid-cols-3">
          {painPoints.map((point, index) => (
            <article data-reveal data-reveal-delay={String(index * 0.06)} class="rounded-[28px] border border-slate-200 bg-slate-50 p-7 shadow-[0_18px_45px_rgba(15,23,42,0.05)] dark:border-slate-800 dark:bg-slate-900/70">
              <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-950 text-lg font-bold text-white dark:bg-cyan-300 dark:text-slate-950">
                {index + 1}
              </div>
              <h3 class="text-xl font-bold tracking-tight">{point.title}</h3>
              <p class="mt-4 leading-relaxed text-slate-600 dark:text-slate-300">{point.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="diagnostico-medico" class="scroll-mt-24 bg-[linear-gradient(180deg,#ffffff,#f8fafc)] px-4 py-14 dark:bg-[linear-gradient(180deg,#020617,#0f172a)] sm:px-6 md:scroll-mt-28 md:py-24">
      <div class="mx-auto grid max-w-7xl gap-7 lg:grid-cols-[0.72fr_1.28fr] lg:items-start">
        <div data-reveal class="order-2 lg:order-1 lg:sticky lg:top-28">
          <span class="inline-flex rounded-full bg-blue-50 px-4 py-2 text-sm font-semibold text-blue-700 dark:bg-cyan-300/10 dark:text-cyan-200">Diagnóstico de Presencia Médica</span>
          <h2 class="mt-4 text-3xl font-bold tracking-tight md:mt-5 md:text-5xl">
            Descubra qué estructura digital necesita su especialidad.
          </h2>
          <p class="mt-4 text-base leading-relaxed text-slate-600 dark:text-slate-300 md:mt-5 md:text-lg">
            En menos de un minuto, el sistema recomienda si conviene empezar con diagnóstico, landing médica, captación SEO o soporte mensual.
          </p>
          <div class="mt-6 hidden rounded-[26px] border border-slate-200 bg-white p-5 shadow-[0_18px_45px_rgba(15,23,42,0.05)] dark:border-slate-800 dark:bg-slate-900 md:block">
            <div class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-700 dark:text-cyan-300">Conversión</div>
            <p class="mt-3 leading-relaxed text-slate-600 dark:text-slate-300">
              El botón final envía a WhatsApp el paquete recomendado y las respuestas para que el lead llegue más calificado.
            </p>
          </div>
        </div>

        <div
          data-medical-funnel
          data-reveal
          class="order-1 rounded-[26px] border border-slate-200 bg-white/90 p-4 shadow-[0_24px_70px_rgba(15,23,42,0.08)] backdrop-blur-xl dark:border-slate-800 dark:bg-slate-900/90 md:rounded-[30px] md:p-8 lg:order-2"
          data-questions={JSON.stringify(medicalFunnelQuestions)}
          data-results={JSON.stringify(medicalFunnelResults)}
          data-phone="593984710898"
        >
          <div class="mb-4 flex flex-col gap-3 text-sm font-semibold text-slate-500 dark:text-slate-400 sm:flex-row sm:items-center sm:justify-between">
            <span data-medical-step>Etapa 1 de {medicalFunnelQuestions.length}</span>
            <span data-medical-count>0 decisiones tomadas</span>
          </div>

          <div class="mb-4 h-2 overflow-hidden rounded-full bg-slate-100 dark:bg-slate-800" aria-hidden="true">
            <span data-medical-progress class="block h-full rounded-full bg-[linear-gradient(90deg,#2563eb,#22d3ee)] transition-[width] duration-300" style="width:0%"></span>
          </div>

          <div class="mb-6 grid grid-cols-5 gap-2" aria-hidden="true">
            {medicalFunnelQuestions.map((_, stageIndex) => (
              <span
                data-medical-stage-dot={String(stageIndex)}
                class="h-1.5 rounded-full bg-slate-200 transition-colors duration-300 dark:bg-slate-800"
              ></span>
            ))}
          </div>

          <div data-medical-screen aria-live="polite"></div>

          <div class="mt-6 flex flex-col gap-3 sm:flex-row md:mt-8">
            <button
              data-medical-back
              class="inline-flex min-h-12 items-center justify-center rounded-2xl border border-slate-200 bg-white px-5 py-3 font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700 disabled:cursor-not-allowed disabled:opacity-45 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200 dark:hover:border-cyan-300"
              type="button"
              disabled
            >
              Volver
            </button>
            <button
              data-medical-restart
              class="inline-flex min-h-12 items-center justify-center rounded-2xl border border-slate-200 bg-white px-5 py-3 font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200 dark:hover:border-cyan-300"
              type="button"
            >
              Reiniciar
            </button>
          </div>
        </div>
      </div>
    </section>

    <section id="demo" class="bg-slate-50 px-6 py-24 dark:bg-slate-900/70">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.92fr_1.08fr] lg:items-center">
        <div data-reveal>
          <span class="inline-flex rounded-full bg-white px-4 py-2 text-sm font-semibold text-blue-700 shadow-sm dark:bg-slate-950 dark:text-cyan-200">Caso demo</span>
          <h2 class="mt-5 text-3xl font-bold tracking-tight md:text-5xl">
            Un ejemplo de landing médica pensada para confianza, servicios y contacto rápido.
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-slate-600 dark:text-slate-300">
            La demo del Dr. Vintimilla muestra cómo presentar trayectoria, procedimientos, ubicación, preguntas frecuentes y botones directos para agendar. Ese mismo sistema se adapta por especialidad.
          </p>
          <div class="mt-8 flex flex-col gap-4 sm:flex-row">
            <a href="https://web-doctor-orpin.vercel.app/#inicio" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-2xl bg-blue-600 px-6 py-3.5 font-semibold text-white shadow-lg shadow-blue-500/20 transition hover:bg-blue-700">
              Ver demo médica
              <Globe2 class="h-5 w-5" />
            </a>
            <a href={whatsappUrl} class="inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-200 px-6 py-3.5 font-semibold text-slate-900 transition hover:border-blue-200 hover:bg-white dark:border-slate-700 dark:text-white dark:hover:bg-slate-950">
              Pedir una versión para mi especialidad
            </a>
          </div>
        </div>

        <div data-reveal data-reveal-delay="0.1" class="grid gap-4 sm:grid-cols-2">
          {services.map((item) => (
            <div class="rounded-[24px] border border-slate-200 bg-white p-5 shadow-[0_18px_45px_rgba(15,23,42,0.05)] dark:border-slate-800 dark:bg-slate-950">
              <CheckCircle2 class="mb-4 h-6 w-6 text-blue-600 dark:text-cyan-300" />
              <div class="font-semibold leading-snug">{item}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="paquetes" class="bg-[linear-gradient(180deg,#f8fafc,#ffffff)] px-6 py-24 dark:bg-[linear-gradient(180deg,#0f172a,#020617)]">
      <div class="mx-auto max-w-7xl">
        <div data-reveal class="mx-auto max-w-3xl text-center">
          <span class="inline-flex rounded-full bg-white px-4 py-2 text-sm font-semibold text-blue-700 shadow-sm dark:bg-slate-900 dark:text-cyan-200">Oferta médica</span>
          <h2 class="mt-5 text-3xl font-bold tracking-tight md:text-5xl">
            Paquetes simples para empezar con diagnóstico y crecer hacia captación local.
          </h2>
        </div>

        <div class="mt-12 grid gap-6 lg:grid-cols-4">
          {packages.map((pack) => (
            <article class:list={[
              'rounded-[30px] border p-7 shadow-[0_20px_55px_rgba(15,23,42,0.07)]',
              pack.highlighted
                ? 'border-blue-300 bg-blue-600 text-white shadow-blue-500/20'
                : 'border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900',
            ]}>
              <h3 class="text-2xl font-bold tracking-tight">{pack.name}</h3>
              <div class:list={['mt-4 text-3xl font-bold', pack.highlighted ? 'text-cyan-100' : 'text-blue-700 dark:text-cyan-300']}>{pack.price}</div>
              <p class:list={['mt-4 leading-relaxed', pack.highlighted ? 'text-blue-50' : 'text-slate-600 dark:text-slate-300']}>{pack.description}</p>
              <div class="mt-7 space-y-3">
                {pack.items.map((item) => (
                  <div class:list={['flex gap-3', pack.highlighted ? 'text-white' : 'text-slate-700 dark:text-slate-200']}>
                    <CheckCircle2 class:list={['mt-0.5 h-5 w-5 flex-none', pack.highlighted ? 'text-cyan-100' : 'text-blue-600 dark:text-cyan-300']} />
                    <span>{item}</span>
                  </div>
                ))}
              </div>
              <a href={whatsappUrl} class:list={[
                'mt-8 inline-flex w-full items-center justify-center gap-2 rounded-2xl px-5 py-3.5 font-semibold transition',
                pack.highlighted
                  ? 'bg-white text-blue-700 hover:bg-blue-50'
                  : 'bg-slate-950 text-white hover:bg-slate-800 dark:bg-cyan-300 dark:text-slate-950 dark:hover:bg-cyan-200',
              ]}>
                Solicitar información
                <ArrowRight class="h-5 w-5" />
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="faq" class="px-6 py-24">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.85fr_1.15fr]">
        <div data-reveal>
          <span class="inline-flex rounded-full bg-blue-50 px-4 py-2 text-sm font-semibold text-blue-700 dark:bg-cyan-300/10 dark:text-cyan-200">FAQ</span>
          <h2 class="mt-5 text-3xl font-bold tracking-tight md:text-5xl">
            Preguntas frecuentes antes de invertir en una presencia médica digital.
          </h2>
        </div>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <article data-reveal class="rounded-[24px] border border-slate-200 bg-slate-50 p-6 dark:border-slate-800 dark:bg-slate-900">
              <h3 class="text-xl font-bold tracking-tight">{faq.question}</h3>
              <p class="mt-3 leading-relaxed text-slate-600 dark:text-slate-300">{faq.answer}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="contacto" class="relative overflow-hidden bg-slate-950 px-6 py-24 text-white">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,_rgba(34,211,238,0.16),_transparent_28%),radial-gradient(circle_at_bottom_right,_rgba(37,99,235,0.26),_transparent_34%)]"></div>
      <div class="relative mx-auto grid max-w-6xl gap-8 lg:grid-cols-[1fr_0.9fr] lg:items-center">
        <div data-reveal>
          <span class="inline-flex rounded-full border border-cyan-300/20 bg-cyan-300/10 px-4 py-2 text-sm font-semibold text-cyan-100">Diagnóstico gratuito</span>
          <h2 class="mt-5 text-3xl font-bold leading-tight tracking-tight md:text-5xl">
            Revisemos cómo aparece su especialidad en Google y qué página podría convertir mejor.
          </h2>
          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-200">
            Envíeme su nombre, especialidad y ciudad. Le devuelvo una lectura breve de presencia digital y la estructura recomendada para su web médica.
          </p>
        </div>
        <div data-reveal data-reveal-delay="0.1" class="rounded-[30px] border border-white/10 bg-white/8 p-8 shadow-[0_30px_80px_rgba(2,6,23,0.32)] backdrop-blur-xl">
          <div class="flex items-center gap-3">
            <MapPin class="h-6 w-6 text-cyan-200" />
            <div>
              <div class="font-bold">Cuenca, Ecuador</div>
              <div class="text-sm text-slate-300">campaña enfocada en especialistas privados</div>
            </div>
          </div>
          <a href={whatsappUrl} class="mt-8 inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-cyan-300 px-6 py-4 font-semibold text-slate-950 shadow-lg shadow-cyan-500/20 transition hover:bg-cyan-200">
            Escribir por WhatsApp
            <MessageCircle class="h-5 w-5" />
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <ScrollAnimations />

  <script>
    const medicalFunnel = document.querySelector('[data-medical-funnel]');

    if (medicalFunnel) {
      const questions = JSON.parse(medicalFunnel.dataset.questions || '[]');
      const results = JSON.parse(medicalFunnel.dataset.results || '{}');
      const phone = medicalFunnel.dataset.phone || '';
      const screen = medicalFunnel.querySelector('[data-medical-screen]');
      const step = medicalFunnel.querySelector('[data-medical-step]');
      const count = medicalFunnel.querySelector('[data-medical-count]');
      const progress = medicalFunnel.querySelector('[data-medical-progress]');
      const backButton = medicalFunnel.querySelector('[data-medical-back]');
      const restartButton = medicalFunnel.querySelector('[data-medical-restart]');
      const stageDots = Array.from(medicalFunnel.querySelectorAll('[data-medical-stage-dot]'));
      let index = 0;
      let answers = [];

      const optionClass = 'group min-h-[7.5rem] rounded-2xl border border-slate-200 bg-white p-4 text-left transition hover:-translate-y-0.5 hover:border-blue-300 hover:shadow-[0_18px_42px_rgba(37,99,235,0.10)] focus:outline-none focus:ring-4 focus:ring-cyan-300/25 disabled:cursor-wait dark:border-slate-700 dark:bg-slate-950 dark:hover:border-cyan-300 md:min-h-[9rem] md:p-5';
      const optionSelectedClass = 'border-cyan-300 bg-cyan-50 ring-4 ring-cyan-300/25 dark:border-cyan-300 dark:bg-cyan-300/10';
      const answerClass = 'rounded-2xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-950';

      function escapeHtml(value) {
        return String(value)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      function resultKey() {
        const score = { diagnostico: 0, presencia: 0, captacion: 0, mensual: 0 };
        for (const answer of answers) {
          for (const [key, value] of Object.entries(answer.weights || {})) {
            score[key] += value || 0;
          }
        }
        return Object.entries(score).sort((a, b) => b[1] - a[1])[0][0];
      }

      function whatsappUrl(result) {
        const answerText = answers
          .map((answer, answerIndex) => `${answerIndex + 1}. ${answer.question}: ${answer.label}`)
          .join('\n');
        const message = `Hola, hice el diagnóstico médico de Nixgo Digital.\n\nResultado desbloqueado: ${result.title}\nPaquete recomendado: ${result.package} (${result.price})\n\nMis respuestas:\n${answerText}\n\nQuiero que revisen mi presencia médica y me recomienden el siguiente paso.`;
        return `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
      }

      function updateShell(complete) {
        const total = questions.length;
        step.textContent = complete ? 'Resultado desbloqueado' : `Etapa ${Math.min(index + 1, total)} de ${total}`;
        count.textContent = `${answers.length} ${answers.length === 1 ? 'decisión tomada' : 'decisiones tomadas'}`;
        progress.style.width = `${(answers.length / total) * 100}%`;
        backButton.disabled = index === 0 || complete;
        stageDots.forEach((dot, dotIndex) => {
          const isActive = complete || dotIndex <= index;
          dot.className = isActive
            ? 'h-1.5 rounded-full bg-[linear-gradient(90deg,#2563eb,#22d3ee)] transition-colors duration-300'
            : 'h-1.5 rounded-full bg-slate-200 transition-colors duration-300 dark:bg-slate-800';
        });
      }

      function renderQuestion() {
        document.body.classList.remove('medical-funnel-complete');
        const current = questions[index];
        updateShell(false);
        screen.innerHTML = `
          <div class="transition-opacity duration-200">
            <div class="flex items-start gap-3">
              <span class="mt-1 inline-flex h-9 w-9 flex-none items-center justify-center rounded-2xl bg-blue-600 text-sm font-bold text-white shadow-lg shadow-blue-500/20 dark:bg-cyan-300 dark:text-slate-950">${index + 1}</span>
              <div>
                <h3 class="text-2xl font-bold tracking-tight text-slate-950 dark:text-white md:text-3xl">${escapeHtml(current.title)}</h3>
                <p class="mt-2 max-w-2xl text-slate-600 dark:text-slate-300">${escapeHtml(current.subtitle)}</p>
              </div>
            </div>
            <div class="mt-5 grid gap-3 md:mt-7 md:grid-cols-3">
              ${current.options.map((option, optionIndex) => `
                <button class="${optionClass}" type="button" data-medical-option-index="${optionIndex}">
                  <span class="mb-4 inline-flex h-8 w-8 items-center justify-center rounded-full border border-slate-200 bg-slate-50 text-sm font-bold text-blue-700 transition group-hover:border-blue-300 group-hover:bg-blue-50 dark:border-slate-700 dark:bg-slate-900 dark:text-cyan-200">${optionIndex + 1}</span>
                  <span class="block font-bold text-slate-950 dark:text-white">${escapeHtml(option.label)}</span>
                  <span class="mt-2 block text-sm leading-relaxed text-slate-600 dark:text-slate-300">${escapeHtml(option.detail)}</span>
                </button>
              `).join('')}
            </div>
          </div>
        `;
      }

      function renderResult() {
        const result = results[resultKey()];
        document.body.classList.add('medical-funnel-complete');
        updateShell(true);
        screen.innerHTML = `
          <div class="grid gap-5 md:gap-6">
            <div class="rounded-[26px] border border-cyan-300/20 bg-[linear-gradient(135deg,rgba(37,99,235,0.10),rgba(34,211,238,0.12))] p-4 dark:border-cyan-300/15 dark:bg-cyan-300/10 md:p-6">
              <div class="flex flex-wrap items-center gap-3">
                <span class="inline-flex w-max rounded-full border border-cyan-300/25 bg-white/70 px-4 py-1.5 text-sm font-semibold text-blue-700 dark:border-cyan-300/20 dark:bg-slate-950/50 dark:text-cyan-100">Resultado desbloqueado</span>
                <span class="inline-flex rounded-full bg-emerald-500/10 px-3 py-1 text-xs font-bold uppercase tracking-[0.16em] text-emerald-700 dark:text-emerald-200">5/5 completo</span>
              </div>
              <p class="mt-4 text-xs font-semibold uppercase tracking-[0.18em] text-blue-700 dark:text-cyan-300 md:text-sm">Recomendación médica</p>
              <h3 class="mt-2 text-3xl font-bold leading-tight tracking-tight text-slate-950 dark:text-white md:text-5xl">${escapeHtml(result.title)}</h3>
              <p class="mt-3 max-w-3xl text-base leading-relaxed text-slate-600 dark:text-slate-300 md:mt-4 md:text-lg">${escapeHtml(result.reason)}</p>
              <div class="mt-4 grid gap-3 rounded-2xl border border-white/70 bg-white/78 p-4 dark:border-slate-700 dark:bg-slate-950/70 sm:grid-cols-[1fr_auto] sm:items-center md:mt-5">
                <span class="font-semibold text-slate-700 dark:text-slate-200">Paquete recomendado</span>
                <span class="text-2xl font-bold leading-tight text-blue-700 dark:text-cyan-300 sm:text-right md:text-xl">
                  ${escapeHtml(result.package)}
                  <span class="block text-xl md:text-lg">${escapeHtml(result.price)}</span>
                </span>
              </div>
            </div>
            <div class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto]">
              <a class="inline-flex min-h-12 items-center justify-center gap-3 rounded-2xl bg-blue-600 px-6 py-3.5 font-semibold text-white shadow-lg shadow-blue-500/20 transition hover:bg-blue-700 dark:bg-cyan-300 dark:text-slate-950 dark:hover:bg-cyan-200" href="${whatsappUrl(result)}" target="_blank" rel="noopener noreferrer">Enviar diagnóstico por WhatsApp</a>
              <button class="inline-flex min-h-12 items-center justify-center rounded-2xl border border-slate-200 bg-white px-6 py-3.5 font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-700 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200" type="button" data-medical-restart-inline>Hacer otra vez</button>
            </div>
            <dl class="grid gap-3 md:grid-cols-2">
              ${answers.map((answer) => `
                <div class="${answerClass}">
                  <dt class="text-sm font-semibold text-slate-500 dark:text-slate-400">${escapeHtml(answer.question)}</dt>
                  <dd class="mt-1 font-semibold text-slate-950 dark:text-white">${escapeHtml(answer.label)}</dd>
                </div>
              `).join('')}
            </dl>
          </div>
        `;
        requestAnimationFrame(() => {
          window.scrollTo({
            top: medicalFunnel.getBoundingClientRect().top + window.scrollY - 108,
            behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          });
        });
      }

      screen.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const optionButton = target.closest('[data-medical-option-index]');
        if (optionButton) {
          const current = questions[index];
          const option = current.options[Number(optionButton.dataset.medicalOptionIndex)];
          const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          const optionButtons = Array.from(screen.querySelectorAll('[data-medical-option-index]'));
          optionButtons.forEach((button) => {
            button.disabled = true;
            button.setAttribute('aria-pressed', button === optionButton ? 'true' : 'false');
          });
          optionButton.className = `${optionButton.className} ${optionSelectedClass}`;
          answers = [
            ...answers.slice(0, index),
            {
              question: current.title,
              label: option.label,
              value: option.value,
              weights: option.weights,
            },
          ];
          window.setTimeout(() => {
            if (index < questions.length - 1) {
              index += 1;
              renderQuestion();
            } else {
              renderResult();
            }
          }, reducedMotion ? 0 : 180);
        }

        if (target.closest('[data-medical-restart-inline]')) {
          restart();
        }
      });

      function back() {
        if (index === 0 || answers.length === questions.length) return;
        answers = answers.slice(0, -1);
        index -= 1;
        renderQuestion();
      }

      function restart() {
        document.body.classList.remove('medical-funnel-complete');
        index = 0;
        answers = [];
        renderQuestion();
      }

      backButton.addEventListener('click', back);
      restartButton.addEventListener('click', restart);
      renderQuestion();
    }
  </script>
</Layout>
