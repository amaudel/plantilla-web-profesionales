const medicalFunnelResults = {
  diagnostico: {
    title: 'Diagnóstico digital médico',
    package: 'Diagnóstico',
    price: 'Gratis',
    reason:
      'Conviene empezar con una lectura rápida de presencia pública, Google Business Profile y oportunidad de web antes de definir inversión.',
  },
  presencia: {
    title: 'Landing médica profesional',
